# === Public (im Browser sichtbar) ===
PUBLIC_SUPABASE_URL=https://<project>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<anon-key>
PUBLIC_TURNSTILE_SITE_KEY=<turnstile-public-site-key>

# === Server-Side (in Cloudflare Pages Functions) ===
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
RESEND_API_KEY=<resend-api-key>
TURNSTILE_SECRET_KEY=<turnstile-secret-key>
MATELSO_API_KEY=<matelso-api-key>

# === Optional fuer Etappe 8.5 (Offline-Conversion-Import) ===
GOOGLE_ADS_DEVELOPER_TOKEN=<token>
GOOGLE_ADS_CLIENT_ID=<oauth-client-id>
GOOGLE_ADS_CLIENT_SECRET=<oauth-client-secret>
GOOGLE_ADS_REFRESH_TOKEN=<oauth-refresh-token>

# === Admin-Leads Bearer-Token (Soft-Fail wenn nicht gesetzt) ===
# Schuetzt /api/leads + /api/leads/cleanup-test-data vor unauthorized GET/DELETE.
# Wenn ADMIN_LEADS_TOKEN nicht gesetzt ist, sind die Endpoints offen (Test-Modus).
# Sobald gesetzt: jeder Request muss "Authorization: Bearer <token>" tragen.
# /admin/leads/ Page promptet beim ersten Visit nach dem Token, speichert ihn in localStorage.
ADMIN_LEADS_TOKEN=<beliebiger-Zufalls-String-32-Zeichen+>

# === Optional fuer /admin/leads (Legacy, ungenutzt) ===
ADMIN_BASIC_AUTH_USER=<user>
ADMIN_BASIC_AUTH_PASS_HASH=<bcrypt-hash>

# === Anwendungs-Konfig ===
CONTACT_EMAIL=info@katharis.de
