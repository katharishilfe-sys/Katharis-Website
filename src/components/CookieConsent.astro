---
/**
 * CookieConsent.astro - Klaro-Bootstrap via CDN (kein npm-Paket erforderlich).
 *
 * Aktiviert sich automatisch sobald mindestens eine der folgenden
 * Env-Variablen in Cloudflare-Pages (Production) gesetzt ist:
 *   - PUBLIC_GA4_MEASUREMENT_ID  (Format: G-XXXXXXXXXX)
 *   - PUBLIC_GTM_CONTAINER_ID    (Format: GTM-XXXXXXX)
 *   - PUBLIC_CLARITY_PROJECT_ID  (Format: xxxxxxxxxx)
 *
 * Ohne Env-Vars: Komponente rendert NICHTS (kein Banner, kein Tracking).
 *
 * Master-Etappe-6: no-tag-before-consent. Skripte werden mit type="text/plain"
 * eingebunden, Klaro wechselt das zu type="text/javascript" sobald Consent gegeben.
 *
 * Marken-Regel 1.7: Traegername (Cleanit) erscheint NICHT - alles unter "Katharis".
 */

import { klaroConfig } from '@lib/klaro-config';

const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || '';
const gtmId = import.meta.env.PUBLIC_GTM_CONTAINER_ID || '';
const clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID || '';

const trackingActive = Boolean(ga4Id || gtmId || clarityId);

// Klaro v0.7.x CDN URL (stable, MIT, ohne externe Tracker)
const KLARO_CDN_BASE = 'https://cdn.jsdelivr.net/npm/klaro@0.7.22/dist';
---

{trackingActive && (
  <>
    <link rel="stylesheet" href={`${KLARO_CDN_BASE}/klaro.min.css`} />

    {/* Klaro-Config global verfuegbar machen */}
    <script
      is:inline
      define:vars={{ config: klaroConfig, ga4Id, gtmId, clarityId }}
      set:html={`
        window.klaroConfig = config;
        window.__katharis_tracking = { ga4Id: ga4Id, gtmId: gtmId, clarityId: clarityId };
      `}
    />

    {/* GA4 - geblockt bis Consent, name="google-analytics" matcht klaro-config */}
    {ga4Id && (
      <>
        <script
          is:inline
          type="text/plain"
          data-type="application/javascript"
          data-name="google-analytics"
          src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}
          async
        />
        <script
          is:inline
          type="text/plain"
          data-type="application/javascript"
          data-name="google-analytics"
          set:html={`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '${ga4Id}', { anonymize_ip: true });
          `}
        />
      </>
    )}

    {/* GTM - als Loader unter "Analyse"-Consent. Einzelne Tags drin (GA4, Ads)
        respektieren Consent-Mode V2 separat (analytics_storage / ad_storage). */}
    {gtmId && (
      <script
        is:inline
        type="text/plain"
        data-type="application/javascript"
        data-name="google-analytics"
        set:html={`
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');
        `}
      />
    )}

    {/* Microsoft Clarity */}
    {clarityId && (
      <script
        is:inline
        type="text/plain"
        data-type="application/javascript"
        data-name="microsoft-clarity"
        set:html={`
          (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${clarityId}");
        `}
      />
    )}

    {/* Klaro-Modal-Container */}
    <div id="klaro"></div>

    {/* Klaro-Bootstrap (laedt no-css Variante, da CSS oben geladen) */}
    <script
      is:inline
      type="module"
      set:html={`
        import('${KLARO_CDN_BASE}/klaro-no-css.js').then((mod) => {
          const Klaro = mod.default || mod;
          window.klaro = Klaro;
          Klaro.setup(window.klaroConfig);
        }).catch((err) => {
          console.error('[CookieConsent] Klaro-Load fehlgeschlagen:', err);
        });
      `}
    />
  </>
)}
