---
import { kontakt } from '@data/content';
import { Phone, Menu, X } from 'lucide-react';

const navLinks = [
  { href: '/service/messie-hilfe/', label: 'Messie-Hilfe' },
  { href: '/service/vor-dem-heimumzug/', label: 'Vor dem Heimumzug' },
  { href: '/pflegekasse/', label: 'Pflegekasse' },
  { href: '/pflegegrad-antrag/', label: 'Pflegegrad-Antrag' },
  { href: '/ueber-uns/', label: 'Über uns' },
  { href: '/kontakt/', label: 'Kontakt' },
];
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2" aria-label="Katharis Startseite">
      <img src="/katharis-logo.png" alt="" width="44" height="44" aria-hidden="true" />
      <span class="text-xl font-bold text-primary">Katharis</span>
    </a>

    <nav class="hidden md:flex gap-6 text-sm font-medium items-center text-primary" aria-label="Hauptnavigation">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:opacity-70">{link.label}</a>
      ))}
    </nav>

    <a
      href={`tel:${kontakt.telefonHref}`}
      class="hidden md:inline-flex items-center gap-2 px-5 py-2 rounded-full font-bold text-white text-sm bg-accent-dark hover:opacity-90 transition-opacity"
      data-cta="anruf-header"
      aria-label={`Jetzt anrufen: ${kontakt.telefonAnzeige}`}
    >
      <Phone size={16} aria-hidden="true" />
      {kontakt.telefonAnzeige}
    </a>

    <button
      id="mobile-menu-toggle"
      class="md:hidden flex items-center justify-center w-10 h-10 text-primary"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <Menu size={24} aria-hidden="true" id="menu-icon-open" />
      <X size={24} aria-hidden="true" id="menu-icon-close" class="hidden" />
    </button>
  </div>

  <nav
    id="mobile-nav"
    class="md:hidden hidden bg-white border-t border-gray-200"
    aria-label="Mobile Navigation"
  >
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-3 text-base font-medium text-primary">
      {navLinks.map((link) => (
        <a href={link.href} class="py-2 border-b border-gray-100 last:border-b-0 hover:opacity-70">{link.label}</a>
      ))}
      <a
        href={`tel:${kontakt.telefonHref}`}
        class="mt-3 inline-flex items-center justify-center gap-2 py-3 rounded-full font-bold text-white bg-accent-dark hover:opacity-90"
      >
        <Phone size={20} aria-hidden="true" />
        {kontakt.telefonAnzeige}
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const nav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !nav?.classList.contains('hidden');
    if (isOpen) {
      nav?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Menü öffnen');
    } else {
      nav?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Menü schließen');
    }
  });
</script>
