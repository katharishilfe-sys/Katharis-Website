---
import { kontakt } from '@data/content';
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2" aria-label="Katharis Startseite">
      <img src="/katharis-logo.png" alt="" width="44" height="44" aria-hidden="true" />
      <span class="text-xl font-bold text-primary">Katharis</span>
    </a>
    <nav class="hidden md:flex gap-6 text-sm font-medium items-center text-primary">
      <a href="/service/messie-hilfe/" class="hover:opacity-70">Messie-Hilfe</a>
      <a href="/service/vor-dem-heimumzug/" class="hover:opacity-70">Vor dem Heimumzug</a>
      <a href="/pflegekasse/" class="hover:opacity-70">Pflegekasse</a>
      <a href="/pflegegrad-antrag/" class="hover:opacity-70">Pflegegrad-Antrag</a>
      <a href="/ueber-uns/" class="hover:opacity-70">Über uns</a>
      <a href="/kontakt/" class="hover:opacity-70">Kontakt</a>
    </nav>
    <a
      href={`tel:${kontakt.telefonHref}`}
      class="hidden md:inline-block px-5 py-2 rounded-full font-bold text-white text-sm bg-accent-dark hover:opacity-90 transition-opacity"
      data-cta="anruf-header"
    >
      {kontakt.telefonAnzeige}
    </a>
  </div>
</header>
