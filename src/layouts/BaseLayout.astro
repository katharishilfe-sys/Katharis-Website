---
import '@/styles/global.css';
import { generateOrganizationSchema } from '@lib/schema-org';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, canonical, ogImage = '/og-image.png', noindex = false } = Astro.props;
const canonicalUrl = canonical ?? Astro.url.href;
const orgSchema = generateOrganizationSchema();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-512.png" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!--
      Cloudflare Web Analytics: privacy-friendly, kein Cookie, DSGVO-ohne-Consent.
      Daniel-Aktion: Cloudflare-Dashboard -> Web Analytics -> Add a site -> katharis-v2.pages.dev
      -> Token einsetzen statt CLOUDFLARE_BEACON_TOKEN_HIER.
      Bis dahin laedt das Skript nur als Stub (kein Tracking).
    -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "CLOUDFLARE_BEACON_TOKEN_HIER"}'
    ></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>
    <slot />
  </body>
</html>
