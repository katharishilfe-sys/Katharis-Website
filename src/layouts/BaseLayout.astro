---
import '@/styles/global.css';
import { generateOrganizationSchema } from '@lib/schema-org';
import { CONSENT_MODE_BOOTSTRAP } from '@lib/tracking';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, canonical, ogImage = '/og-image.png', noindex = false } = Astro.props;
const canonicalUrl = canonical ?? Astro.url.href;
const orgSchema = generateOrganizationSchema();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon-512.png" />

    <!-- Theme-Color fuer Mobile-Browser-Chrome (Brand-Primary) -->
    <meta name="theme-color" content="#1A3C34" />

    <!-- Format-Detection deaktivieren um iOS auto-link von Telefonnummern zu kontrollieren -->
    <meta name="format-detection" content="telephone=no" />

    <!-- Consent-Mode-V2 Default-Deny (vor jeglichem Tracking-Skript laden) -->
    <script is:inline set:html={CONSENT_MODE_BOOTSTRAP} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!--
      Cloudflare Web Analytics: kommt automatisch via existierende katharis.de-Site
      nach Cutover (Etappe 7). Bis dahin reicht der Manual-Snippet nicht
      (Add-a-site fuer pages.dev-Subdomain wird von Cloudflare blockiert).
    -->
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Zum Hauptinhalt springen</a>
    <slot />
  </body>
</html>
