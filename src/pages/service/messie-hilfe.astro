---
import PageLayout from '@layouts/PageLayout.astro';
import { hooks, pflegekassenTöpfe } from '@data/content';
import { generateLocalBusinessSchema, generateServiceSchema, generateFAQPageSchema } from '@lib/schema-org';
import CallCTA from '@components/CallCTA';
import RueckrufButton from '@components/RueckrufButton';

const localBusinessSchema = generateLocalBusinessSchema();
const serviceSchema = generateServiceSchema({
  serviceName: 'Messie-Hilfe in Stuttgart und Landkreis Böblingen',
  serviceDescription: 'Spezialist für Entlastungsleistungen bei Verwahrlosung. Para 45a SGB XI anerkannt. Pflegekassen-Direktabrechnung möglich.',
  serviceUrl: 'https://katharis.de/service/messie-hilfe/',
});

const faqs = [
  {
    question: 'Was ist mit Wertgegenständen, die ich nicht aufheben will, die aber wertvoll sind?',
    answer: 'Wir verschenken oder geben an soziale Stellen weiter wenn Sie das wünschen. Erlöse aus Verkauf bekommen Sie zugeschrieben. Bei Wert-Gegenständen machen wir Foto-Doku und Wert-Liste für Ihre Unterlagen.',
  },
  {
    question: 'Wie ist es mit der Hygiene wenn die Wohnung sehr verschmutzt ist?',
    answer: 'Wir kommen mit Atemschutz, Handschuhen, Schuhüberziehern. Bei Verdacht auf Schimmel oder Asbest sprechen wir das an und koordinieren Spezialist-Beseitigung. Sie tragen kein Risiko.',
  },
  {
    question: 'Was ist wenn meine Mutter sich gegen die Hilfe sträubt?',
    answer: 'Wir kommen nicht ohne Einwilligung des Klienten oder einer Vollmacht. Bei Demenz oder schwerer Depression kann eine gesetzliche Betreuung nötig sein, dafür ist der Pflegestützpunkt oder das Betreuungsgericht zuständig. Wir vermitteln Ihnen die richtigen Stellen.',
  },
  {
    question: 'Wie diskret ist das wirklich?',
    answer: 'Neutrale Fahrzeuge ohne Werbung. Unauffällige Arbeitskleidung. Keine Sicht-Inhalte nach außen. Tageszeit nach Ihrem Wunsch. Wir tragen die Geschichte nicht weiter, weder im Gespräch mit anderen Klienten noch privat.',
  },
  {
    question: 'Was kostet die Vor-Ort-Begutachtung?',
    answer: 'Sie kostet nichts. Das Erstgespräch am Telefon ist kostenlos, der Vor-Ort-Termin zur Auftrags-Einschätzung ebenfalls. Erst wenn Sie uns beauftragen, beginnt die kostenpflichtige Arbeit.',
  },
  {
    question: 'Was passiert wenn die Pflegekasse den Antrag ablehnt?',
    answer: 'Wir besprechen das transparent mit Ihnen, bevor die Arbeit beginnt. Sie haben dann zwei Optionen: Widerspruch (über Pflegestützpunkt oder Anwalt, vermitteln wir gerne) oder Privat-Backup-Vertrag mit transparentem Festpreis oder Stundensatz, 19 Prozent Umsatzsteuer.',
  },
  {
    question: 'Wie viele Tage brauchen Sie für eine Messie-Wohnung?',
    answer: 'Typisch 2 bis 7 Tage je nach Wohnungsgroesse und Verschmutzungsgrad. Eine 2-Zimmer-Wohnung mit moderater Verwahrlosung ist meist in 2-3 Tagen fertig. Bei extremer Verwahrlosung mit Schädlings- oder Schimmelbefall kann es 5-7 Tage dauern, dann mit Spezialist-Hinzuziehung.',
  },
  {
    question: 'Was wenn in der Wohnung Tiere leben?',
    answer: 'Wir informieren als erstes Tierschutz oder Veterinaeramt, falls Tiere in schlechtem Zustand sind. Erst dann beginnt die Wohnungs-Arbeit. Bei Tierhalter-Hilfe ohne Bedarf an Veterinaeramt koordinieren wir mit Tierschutz-Verein oder Tierheim wenn Sie das wünschen.',
  },
  {
    question: 'Bekomme ich eine schriftliche Auftrags-Bestätigung?',
    answer: 'Ja. Vor Auftragsbeginn unterschreiben Sie einen Pflegekassen-Sondervertrag (bei Direktabrechnung) oder einen Privat-Backup-Vertrag. Beide enthalten Leistungs-Beschreibung, Termine, Kostenrahmen, Datenschutz-Klauseln und Wert-Erhaltungs-Standards.',
  },
  {
    question: 'Wer ist vor Ort im Einsatz?',
    answer: 'Mindestens Daniel oder Kemal als Auftrags-Verantwortliche. Bei größeren Aufträgen kommen 2-4 weitere geschulte Mitarbeiter dazu. Alle sind nach Para 45a SGB XI qualifiziert, mit aktueller Hygiene- und Erste-Hilfe-Schulung.',
  },
  {
    question: 'Was wenn Nachbarn merken dass Sie da sind?',
    answer: 'Wir kommen mit unauffaelligen Fahrzeugen und tragen keine Werbung. Bei Begegnungen im Treppenhaus stellen wir uns nicht vor, das ist normale Diskretion. Wenn Nachbarn aktiv fragen, sagen wir nur: "Reinigung" und gehen weiter. Sie als Auftraggeber bestimmen wer was wissen soll.',
  },
];

const faqSchema = generateFAQPageSchema(faqs);

const serviceKarten = [
  {
    title: 'Sortierung',
    text: 'Wir gehen Schritt für Schritt durch die Wohnung und sortieren in drei Kategorien: Erbstücke und Werte, Verschenken oder Sozialkaufhaus, Entsorgung. Sie entscheiden, was in welche Kategorie geht.',
  },
  {
    title: 'Tiefenreinigung',
    text: 'Böden, Sanitär-Bereiche, Küche, Fenster. Mit professionellen Reinigungs-Mitteln und Schutz-Ausstattung. Bei besonderer Verschmutzung mit Atemschutz und Handschuhen.',
  },
  {
    title: 'Vermieter-Übergabe besenrein',
    text: 'Wenn die Wohnung leer werden muss, koordinieren wir den Vermieter-Termin. Wir übergeben besenrein mit Übergabe-Protokoll. Bei Pflegekassen-Direktabrechnung sind die Kosten dafür mit abgedeckt.',
  },
  {
    title: 'Pflegekassen-Direkt-Abrechnung',
    text: 'Bei vorhandenem Pflegegrad rechnen wir direkt mit Ihrer Pflegekasse ab. Sie unterschreiben einen Pflegekassen-Sondervertrag mit Abtretungserklärung, alles weitere läuft über uns. Sie haben keine Vorauslage.',
  },
];
---

<PageLayout
  title="Messie-Hilfe Stuttgart - Pflegekasse zahlt | Katharis"
  description="Spezialist für Messie-Hilfe und Verwahrlosung in Stuttgart und LK Böblingen. Anerkannt nach Para 45a SGB XI. Bis zu 100 Prozent Kostenübernahme möglich. Diskret."
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="bg-background py-16 md:py-24">
    <div class="max-w-content mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold text-primary leading-tight">
        Messie-Hilfe in Stuttgart und Landkreis Böblingen
      </h1>
      <p class="mt-4 text-lg text-primary/80">{hooks.master}</p>
      <p class="mt-2 text-sm text-primary/80">{hooks.geltungsbereich}</p>
      <p class="mt-6 text-primary/80 text-base">{hooks.sekundaer}</p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-messie-hero" />
      </div>
    </div>
  </section>

  <!-- Was ist Messie-Hilfe -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Was ist Messie-Hilfe?</h2>
    <p class="text-primary/80">
      Wenn die Wohnung von jemandem, der Ihnen wichtig ist, über Monate oder Jahre auf der Strecke geblieben ist,
      dann ist das oft kein einzelner Vorfall, sondern Folge einer langen Entwicklung. Demenz, Depression, Sucht,
      Burnout, Vereinsamung, schwere Erkrankungen oder einfach die Erschöpfung des Alters bringen Menschen in
      Situationen, die sie alleine nicht mehr bewältigen können. Und Sie als Tochter, Sohn, Partnerin oder Partner
      stehen plötzlich vor einer Wohnung, die nicht mehr die ist, die Sie kennen.
    </p>
    <p class="mt-4 text-primary/80">
      Sie sind nicht alleine damit. Wir sehen jeden Monat Fälle, die genauso aussehen. Es gibt einen Weg nach vorne,
      und der beginnt mit einem ruhigen Gespräch.
    </p>
    <p class="mt-4 text-primary/80">
      Wir übernehmen die operative Arbeit, ohne Wertung, ohne Sensationalisierung, mit Diskretion. Sortierung von dem,
      was bleiben soll. Tiefenreinigung von dem, was sich angesammelt hat. Vermieter-Übergabe wenn die Wohnung leer
      werden muss. Direkt-Abrechnung mit der Pflegekasse, wenn ein Pflegegrad vorliegt.
    </p>
  </section>

  <!-- Pflegekassen-Akkordeon -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-6">Wie funktioniert die Kostenübernahme?</h2>
      <div class="space-y-3">
        {pflegekassenTöpfe.map((topf) => (
          <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
            <summary class="font-bold text-primary cursor-pointer">{topf.paragraph}: {topf.title} ({topf.betrag})</summary>
            <div class="mt-3 text-primary/80 text-sm">
              <p><strong>Wer:</strong> {topf.wer}</p>
              <p class="mt-2">{topf.description}</p>
            </div>
          </details>
        ))}
      </div>
      <p class="mt-6 text-sm text-primary/70">
        Im kostenlosen Erstgespräch klären wir gemeinsam mit Ihnen, welche Pflegekassen-Leistungen für Ihre Situation
        in Frage kommen können. Noch kein Pflegegrad? Wir helfen administrativ beim Antrag, mehr dazu auf
        <a href="/pflegegrad-antrag/" class="underline text-accent-dark">Pflegegrad-Antrags-Hilfe</a>.
      </p>
    </div>
  </section>

  <!-- Diskretion und Würde -->
  <section class="py-12 bg-background">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Diskretion und Würde</h2>
      <p class="text-primary/80">
        Wir arbeiten so, dass niemand mitbekommen muss, was bei Ihnen oder Ihrer Mutter oder Ihrem Vater passiert.
        Neutrale Fahrzeuge ohne auffällige Werbung. Unauffällige Kleidung. Wenn Sie es wünschen, arbeiten wir zu
        Tageszeiten mit wenig Nachbarn-Verkehr.
      </p>
      <p class="mt-4 text-primary/80">
        Erbstücke und persönliche Erinnerungs-Stücke besprechen wir aktiv mit Ihnen vor der Entsorgung.
        Was Ihnen wichtig ist, bleibt.
      </p>
    </div>
  </section>

  <!-- Sicherheit und Hygiene -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Sicherheit und Hygiene</h2>
      <p class="text-primary/80">
        Verwahrloste Wohnungen können Hygiene-Risiken bergen. Damit niemand zu Schaden kommt, kommen wir mit
        professioneller Schutz-Ausstattung:
      </p>
      <ul class="mt-4 space-y-2 text-primary/80 list-disc list-inside">
        <li>Atemschutzmasken (FFP3) bei Schimmel- oder Staub-Verdacht</li>
        <li>Einweg-Handschuhe und Schuhüberzieher</li>
        <li>Spezielle Anzuege bei extremer Verwahrlosung oder biologischer Belastung</li>
        <li>Hepatitis- und Tetanus-Impfschutz für Daniel, Kemal und Mitarbeiter aktuell</li>
      </ul>
      <p class="mt-4 text-primary/80">
        Bei Verdacht auf <strong>Asbest, Schimmel oder Biowaste</strong> ziehen wir Spezialisten hinzu (Schimmel-Beseitigung,
        Asbest-Sanierung). Mehrkosten besprechen wir transparent vor Auftragsbeginn, nichts geht hinter Ihrem Ruecken.
      </p>
    </div>
  </section>

  <!-- Beispiel-Fälle (anonymisiert) -->
  <section class="py-12 bg-background">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-6">Beispiel-Fälle aus unserer Praxis</h2>
      <p class="text-sm text-primary/80 mb-6">
        Anonymisiert. Echte Fälle, mit Erlaubnis der Auftraggeber zur Veröffentlichung in dieser Form.
      </p>
      <div class="space-y-6">
        <article class="bg-white p-6 rounded-xl border border-primary/15">
          <h3 class="font-bold text-primary">Demenz-Wohnung in Stuttgart-West, 2 Zimmer</h3>
          <p class="mt-2 text-sm text-primary/80">
            Tochter sah Mutter (78, Pflegegrad 3) zum Geburtstag und stand vor Wohnung die seit Jahren nicht mehr
            geluefte oder geputzt war. Lebensmittel angeschimmelt, Wege durch Wohnung schmal, Bad nicht nutzbar.
            Mutter wollte ins Pflegeheim, Wohnung musste zurueck an Vermieter in 4 Wochen.
            <strong>Lösung:</strong> Erstgespräch am Tag der Anfrage, Vor-Ort-Termin am Folgetag, 4 Tage Vollräumung,
            Tiefenreinigung, Vermieter-Übergabe besenrein. Direktabrechnung mit AOK über Para 45a-Anerkennung,
            Tochter zahlte nichts. Erbstücke (Foto-Album, Schmuck-Schachtel) sortiert und der Tochter übergeben.
          </p>
        </article>
        <article class="bg-white p-6 rounded-xl border border-primary/15">
          <h3 class="font-bold text-primary">Witwer in Böblingen, 3 Zimmer</h3>
          <p class="mt-2 text-sm text-primary/80">
            Witwer (82, Pflegegrad 1) lebte allein nach Tod der Frau. Sozialdienst meldete Sich beim Klient-Sohn
            mit Hinweis auf Hygiene-Maengel. Sohn rief uns an. Wir kamen, der Witwer war vorsichtig aber liess
            uns rein. Wir machten 5 Tage Sortierung mit ihm gemeinsam, hat Erinnerungsstuecke an seine Frau aktiv
            beigemischt zur Behalten-Kategorie. Klient blieb in Wohnung, Wohnumfeldverbesserung (Para 40)
            übernahm Pflegekasse, Kostenübernahme zu 100 Prozent.
          </p>
        </article>
        <article class="bg-white p-6 rounded-xl border border-primary/15">
          <h3 class="font-bold text-primary">Sozialdienst-Vermittlung Sindelfingen</h3>
          <p class="mt-2 text-sm text-primary/80">
            Pflegestützpunkt vermittelte Klientin (66, Pflegegrad 2 nach Schlaganfall). Wohnung im Erdgeschoss,
            Betroffene konnte sich nicht mehr buecken, Boden voller liegengebliebener Waesche, Küche unbenutzbar.
            Wir reorganisierten den Wohnbereich mit ergonomischer Hilfsmittel-Beratung (Pflegestützpunkt half),
            machten Tiefenreinigung. 2 Tage Aufwand. Direktabrechnung über Para 45b und Para 42a kombiniert.
            Klientin lebt seit dem wieder selbststänTig in der Wohnung.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Service-Karten -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-6">Was wir konkret machen</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {serviceKarten.map((karte) => (
          <div class="bg-background/30 p-5 rounded-lg border border-primary/10">
            <h3 class="font-bold text-primary">{karte.title}</h3>
            <p class="mt-2 text-sm text-primary/80">{karte.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-6">Häufige Fragen</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
          <summary class="font-bold text-primary cursor-pointer">{faq.question}</summary>
          <p class="mt-3 text-primary/80 text-sm">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-background">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-primary">Sprechen wir.</h2>
      <p class="mt-4 text-primary/80">
        Im kostenlosen Erstgespräch am Telefon hören wir zu, klären Ihre Pflegekassen-Optionen und vereinbaren
        wenn Sie wollen einen Vor-Ort-Termin. Sie gehen kein Risiko ein. Sie bekommen Klarheit.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8 justify-center">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-messie-final" />
      </div>
    </div>
  </section>
</PageLayout>
