---
import PageLayout from '@layouts/PageLayout.astro';

const articles = [
  {
    slug: '/ratgeber/messie-syndrom/',
    title: 'Messie-Syndrom: Was Angehörige wissen sollten',
    excerpt: 'Ursachen, Anzeichen und wie Sie als Angehöriger handeln können, ohne Druck und ohne Wertung.',
  },
  {
    slug: '/ratgeber/pflegekasse-entlastung/',
    title: 'Pflegekasse und Entlastungsleistungen 2026',
    excerpt: 'Welche Pflegekassen-Töpfe nach Para 45a/45b/42a/40 SGB XI Sie für eine Entlastung nutzen können.',
  },
  {
    slug: '/ratgeber/heimumzug-kosten/',
    title: 'Heimumzug und Kosten: Wer zahlt die Wohnungsräumung?',
    excerpt: 'Vermieter-Frist, Pflegekassen-Direktabrechnung, Vollräumung mit Pflegegrad. Wie Sie keine Doppelmiete zahlen.',
  },
];
---

<PageLayout
  title="Ratgeber Pflegekasse und Entlastung | Katharis"
  description="Aufklärungs-Artikel zu Messie-Syndrom, Pflegekassen-Entlastung und Heimumzug-Kosten. Mit aktuellen Beträgen 2026."
>
  <section class="bg-background py-16">
    <div class="max-w-content mx-auto px-4">
      <h1 class="text-4xl font-bold text-primary">Ratgeber</h1>
      <p class="mt-4 text-lg text-primary/80">
        Aufklärungs-Artikel zu Pflegekasse, Entlastungsleistungen und komplexen Pflegefällen.
        Faktencheck gegen Gesetzestext und Fachquellen.
      </p>
    </div>
  </section>

  <section class="py-12 max-w-content mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {articles.map((article) => (
        <a href={article.slug} class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow border border-primary/10">
          <h2 class="text-xl font-bold text-primary">{article.title}</h2>
          <p class="mt-3 text-primary/80 text-sm">{article.excerpt}</p>
          <p class="mt-4 text-accent-dark font-bold text-sm">Weiterlesen &rarr;</p>
        </a>
      ))}
    </div>
  </section>
</PageLayout>
