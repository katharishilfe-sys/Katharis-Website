---
import PageLayout from '@layouts/PageLayout.astro';
import { generateBreadcrumbListSchema } from '@lib/schema-org';

type Article = {
  slug: string;
  title: string;
  excerpt: string;
  category: 'Pflegekasse' | 'Räumung' | 'Pflegefall';
  lesedauer: string;
};

const articles: Article[] = [
  {
    slug: '/ratgeber/pflegekasse-entlastung/',
    title: 'Pflegekasse und Entlastung 2026: Alle Töpfe',
    excerpt:
      'Welche Pflegekassen-Töpfe nach §45a, §45b, §42a und §40 SGB XI Sie kombinieren können. Voraussetzungen, Beträge, Antrags-Schritte und Beispiel-Rechnung Pflegegrad 3.',
    category: 'Pflegekasse',
    lesedauer: '8 Min.',
  },
  {
    slug: '/ratgeber/pflegekasse-direktabrechnung/',
    title: 'Pflegekassen-Direktabrechnung erklärt',
    excerpt:
      'Wie funktioniert §45a-Direktabrechnung. Was Sie als Klient tun müssen, was nicht. Mit Vergleichs-Tabelle Direktabrechnung gegen Eigenbeauftragung.',
    category: 'Pflegekasse',
    lesedauer: '6 Min.',
  },
  {
    slug: '/ratgeber/wohnumfeldverbesserung-antrag/',
    title: 'Wohnumfeldverbesserung: bis 4.180 Euro Zuschuss',
    excerpt:
      '§40 SGB XI für Bad-Umbau, Treppenlift, Türverbreiterung. Antrags-Anleitung mit Praxis-Beispielen aus Stuttgart und Böblingen.',
    category: 'Pflegekasse',
    lesedauer: '7 Min.',
  },
  {
    slug: '/ratgeber/md-begutachtung-vorbereiten/',
    title: 'MD-Begutachtung vorbereiten',
    excerpt:
      '14-Tage-Pflegetagebuch, Hilfsmittel-Liste, was zeigen, was sagen. So bereiten Sie sich richtig auf den Termin mit dem Medizinischen Dienst vor.',
    category: 'Pflegekasse',
    lesedauer: '9 Min.',
  },
  {
    slug: '/ratgeber/heimumzug-kosten/',
    title: 'Heimumzug und Kosten: Wer zahlt die Räumung?',
    excerpt:
      'Vermieter-Frist, Pflegekassen-Direktabrechnung, Kostenfaktoren bei Vollräumung vor dem Pflegeheim-Umzug. Wie Sie Doppelmiete vermeiden und Erbstücke sichern.',
    category: 'Räumung',
    lesedauer: '8 Min.',
  },
  {
    slug: '/ratgeber/sterbefall-wohnungsraeumung/',
    title: 'Sterbefall und Wohnungsräumung',
    excerpt:
      'Erbschein, Sonderkündigungsrecht BGB §564, Pflegekassen-Endabrechnung, Erbengemeinschaft. Schritt-für-Schritt-Anleitung mit 6 häufigen Fragen.',
    category: 'Räumung',
    lesedauer: '7 Min.',
  },
  {
    slug: '/ratgeber/messie-syndrom/',
    title: 'Messie-Syndrom: Ratgeber für Angehörige',
    excerpt:
      'Ursachen, Anzeichen und konkrete Schritte bei Verwahrlosung. Wie Sie Angehörige unterstützen, welche Pflegekassen-Töpfe greifen, wann professionelle Hilfe sinnvoll ist.',
    category: 'Pflegefall',
    lesedauer: '9 Min.',
  },
];

const grouped = {
  Pflegekasse: articles.filter((a) => a.category === 'Pflegekasse'),
  Räumung: articles.filter((a) => a.category === 'Räumung'),
  Pflegefall: articles.filter((a) => a.category === 'Pflegefall'),
};

const breadcrumbSchema = generateBreadcrumbListSchema([
  { name: 'Start', url: 'https://katharis.de/' },
  { name: 'Ratgeber', url: 'https://katharis.de/ratgeber/' },
]);

const categoryStyle = {
  Pflegekasse: 'bg-primary/10 text-primary',
  Räumung: 'bg-accent/15 text-accent-dark',
  Pflegefall: 'bg-primary/15 text-primary',
};
---

<PageLayout
  title="Ratgeber: Pflegekasse, Räumung und Pflegefälle | Katharis"
  description="Aufklärungs-Artikel zu Pflegekassen-Töpfen, Wohnungsräumung und komplexen Pflegefällen. Mit aktuellen Beträgen 2026 und Bezug auf den SGB-XI-Gesetzestext."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="bg-background py-16">
    <div class="max-w-content mx-auto px-4">
      <p class="text-sm text-primary/80">
        <a href="/" class="underline">Start</a> &rsaquo; Ratgeber
      </p>
      <h1 class="text-4xl font-bold text-primary mt-4">Ratgeber</h1>
      <p class="mt-4 text-lg text-primary/80">
        Aufklärungs-Artikel zu Pflegekasse, Entlastungsleistungen und komplexen Pflegefällen.
      </p>
      <p class="mt-4 text-sm text-primary/70">
        Verfasser: Daniel Altenhof, Initiator und operativer Leiter Katharis. Jeder Artikel verweist
        auf den SGB-XI-Gesetzestext (gesetze-im-internet.de), das Bundesgesundheitsministerium oder
        die Compass Pflegeberatung als Quellen. Stand 2026, Beträge laufend aktualisiert.
      </p>
    </div>
  </section>

  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-2">Pflegekasse verstehen</h2>
    <p class="text-primary/70 text-sm mb-6">Welche Töpfe es gibt, wer Anspruch hat, wie der Antrag läuft.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {grouped.Pflegekasse.map((article) => (
        <a href={article.slug} class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow border border-primary/10 block">
          <div class="flex items-center gap-2 text-xs">
            <span class={`px-2 py-1 rounded ${categoryStyle[article.category]} font-bold`}>{article.category}</span>
            <span class="text-primary/70">{article.lesedauer}</span>
          </div>
          <h3 class="text-xl font-bold text-primary mt-3">{article.title}</h3>
          <p class="mt-3 text-primary/80 text-sm">{article.excerpt}</p>
          <p class="mt-4 text-accent-dark font-bold text-sm">Weiterlesen &rarr;</p>
        </a>
      ))}
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-2">Wohnung räumen</h2>
      <p class="text-primary/70 text-sm mb-6">Fristen, Kosten, Pflegekassen-Optionen, Erbstücke sichern.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {grouped.Räumung.map((article) => (
          <a href={article.slug} class="bg-background/40 p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow border border-primary/10 block">
            <div class="flex items-center gap-2 text-xs">
              <span class={`px-2 py-1 rounded ${categoryStyle[article.category]} font-bold`}>{article.category}</span>
              <span class="text-primary/70">{article.lesedauer}</span>
            </div>
            <h3 class="text-xl font-bold text-primary mt-3">{article.title}</h3>
            <p class="mt-3 text-primary/80 text-sm">{article.excerpt}</p>
            <p class="mt-4 text-accent-dark font-bold text-sm">Weiterlesen &rarr;</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-2">Pflegefälle begleiten</h2>
    <p class="text-primary/70 text-sm mb-6">Hintergründe, Gesprächsführung mit Angehörigen, wann externe Hilfe sinnvoll wird.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {grouped.Pflegefall.map((article) => (
        <a href={article.slug} class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow border border-primary/10 block">
          <div class="flex items-center gap-2 text-xs">
            <span class={`px-2 py-1 rounded ${categoryStyle[article.category]} font-bold`}>{article.category}</span>
            <span class="text-primary/70">{article.lesedauer}</span>
          </div>
          <h3 class="text-xl font-bold text-primary mt-3">{article.title}</h3>
          <p class="mt-3 text-primary/80 text-sm">{article.excerpt}</p>
          <p class="mt-4 text-accent-dark font-bold text-sm">Weiterlesen &rarr;</p>
        </a>
      ))}
    </div>
  </section>

  <section class="py-12 bg-background">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Sie suchen ein bestimmtes Thema?</h2>
      <p class="text-primary/80">
        Wenn Ihre Frage hier nicht beantwortet ist, rufen Sie uns an. Das Erstgespräch ist kostenlos,
        wir hören zu und vermitteln bei Bedarf an Pflegestützpunkt, Compass Pflegeberatung
        (0800 101 88 00) oder andere kostenlose Anlaufstellen.
      </p>
      <p class="mt-4 text-sm text-primary/70">
        Unser Ziel mit diesen Ratgebern: dass Sie informiert und ohne Druck entscheiden können. Wir
        sind anerkannter Anbieter nach §45a SGB XI für Stadt Stuttgart und Landkreis Böblingen.
      </p>
    </div>
  </section>
</PageLayout>
