---
import PageLayout from '@layouts/PageLayout.astro';
import { hooks } from '@data/content';
import { generateHowToSchema, generateFAQPageSchema } from '@lib/schema-org';
import CallCTA from '@components/CallCTA';
import RueckrufButton from '@components/RueckrufButton';

const faqs = [
  {
    question: 'Beraten Sie mich auch zu meinen Pflegekassen-Ansprüchen?',
    answer: 'Nein. Wir helfen administrativ beim Antrag (Formulare ausfüllen, Begutachtung vorbereiten, Botengang). Inhaltliche Beratung zu Leistungs-Ansprüchen ist Aufgabe der Pflegestützpunkte. Die Pflegestützpunkte beraten kostenlos. Wir vermitteln Ihnen gerne den richtigen Stadtbezirks-Kontakt.',
  },
  {
    question: 'Wie lange dauert der Pflegegrad-Antrag?',
    answer: 'Typisch fünf bis 25 Wochen. Bei Eilfällen (zum Beispiel direkt nach Krankenhaus-Entlassung) muss die Pflegekasse innerhalb von einer Woche entscheiden.',
  },
  {
    question: 'Was ist die MD-Begutachtung?',
    answer: 'Ein Termin bei Ihnen zuhause, bei dem ein Gutachter des Medizinischen Dienstes prüft, wie selbstständig die pflegebedürftige Person noch ist. Das Gutachten ist die Grundlage für die Pflegekassen-Entscheidung. Vorbereitung ist wichtig.',
  },
  {
    question: 'Was wenn ich keinen Pflegegrad bekomme?',
    answer: 'Sie haben einen Monat Zeit für einen Widerspruch. Wir vermitteln Ihnen Pflegestützpunkt oder Sozialrechts-Anwalt. Falls Sie sich gegen einen Widerspruch entscheiden, können Sie die Entlastungsleistung als Privatauftrag bei uns buchen.',
  },
  {
    question: 'Was kostet die Antrags-Hilfe?',
    answer: 'Im kostenlosen Erstgespräch am Telefon klären wir Ihre Situation. Wenn Sie unsere Antrags-Hilfe in Anspruch nehmen, rechnen wir das im Rahmen der späteren Entlastungsleistung mit Ihrer Pflegekasse direkt ab. Bei Antrags-Ablehnung tragen wir den Aufwand für die Antrags-Hilfe selbst, Sie zahlen nichts dafür.',
  },
  {
    question: 'Was passiert wenn die pflegebedürftige Person den Antrag nicht selbst stellen kann?',
    answer: 'Sie können den Antrag als Angehöriger stellen, brauchen dafür aber eine schriftliche Vollmacht. Bei dauerhafter Geschäftsunfähigkeit ist eine Vorsorgevollmacht oder gerichtliche Betreuung notwendig. Im Erstgespräch klären wir, welcher Weg in Ihrer Situation passt. Vollmachts-Templates haben wir vorbereitet.',
  },
  {
    question: 'Welche Pflegegrade gibt es und wofür reicht welcher?',
    answer: 'Pflegegrad 1 (geringe Beeinträchtigung) gibt Zugang zum Entlastungsbetrag und Wohnumfeldverbesserung. Ab Pflegegrad 2 öffnet sich der gemeinsame Jahresbetrag (Verhinderungs- plus Kurzzeitpflege) und die Pflegesachleistungen. Ab Pflegegrad 4 sind die Beträge spürbar höher. Wir helfen Ihnen administrativ den Antrag zu stellen, die Einstufung trifft der Medizinische Dienst nach Hausbesuch.',
  },
  {
    question: 'Wie bereite ich die MD-Begutachtung am besten vor?',
    answer: 'Führen Sie über mindestens 14 Tage ein Pflegetagebuch. Notieren Sie täglich, welche Hilfe wann notwendig war: Körperpflege, Anziehen, Essen, Mobilität, Medikamenten-Verabreichung, Termin-Begleitung. Halten Sie alle Diagnosen, Medikamenten-Listen und Hilfsmittel bereit. Schönen Sie nichts. Der MD-Gutachter sieht oft nur eine Stunde, das Tagebuch zeigt den Alltag.',
  },
  {
    question: 'Wer trägt die Kosten wenn die Pflegekasse ablehnt?',
    answer: 'Wenn der Pflegegrad-Antrag abgelehnt wird und Sie keinen Widerspruch einlegen wollen, können Sie unsere Entlastungsleistung als Privatauftrag buchen. Wir besprechen die Kosten transparent vor Beginn der Arbeit. Eine versteckte Kosten-Falle gibt es bei uns nicht.',
  },
  {
    question: 'Kann ich auch nach Krankenhaus-Entlassung kurzfristig einen Antrag stellen?',
    answer: 'Ja, sogar mit Eilfristen-Vorrang. Bei akut neu entstandener Pflegebedürftigkeit nach Krankenhaus-Entlassung muss die Pflegekasse innerhalb einer Woche entscheiden. Wir helfen Ihnen, den Antrag in dieser Eilfrist korrekt zu stellen, damit kein Zeitverlust entsteht.',
  },
];

const faqSchema = generateFAQPageSchema(faqs);

const howToSchema = generateHowToSchema({
  name: 'Pflegegrad beantragen mit administrativer Hilfe',
  description: 'Schritt-für-Schritt-Anleitung Pflegegrad-Antrag mit administrativer Hilfe von Katharis.',
  steps: [
    { name: 'Antrag stellen', text: 'Formloser Anruf bei der Pflegekasse reicht. Antragsdatum ist der Tag des Anrufs.' },
    { name: 'MD-Termin abwarten', text: 'Der Medizinische Dienst meldet sich innerhalb von ein bis vier Wochen.' },
    { name: 'Begutachtung vorbereiten', text: 'Pflegetagebuch, Hilfsmittel-Liste, Symptom-Doku - wir helfen Ihnen administrativ.' },
    { name: 'MD-Gutachten + Pflegekassen-Entscheidung', text: 'Entscheidung typisch in 5 bis 25 Wochen.' },
    { name: 'Bei Bewilligung', text: 'Pflegegrad gilt rückwirkend ab Antragsdatum. Leistungen können rückwirkend erstattet werden.' },
  ],
});

const steps = [
  { num: 1, title: 'Antrag stellen', body: 'Formloser Anruf bei der Pflegekasse reicht. Antragsdatum ist der Tag des Anrufs.' },
  { num: 2, title: 'MD-Termin abwarten', body: 'Der Medizinische Dienst meldet sich innerhalb von ein bis vier Wochen mit einem Termin.' },
  { num: 3, title: 'Begutachtung vorbereiten', body: 'Pflegetagebuch, Hilfsmittel-Liste, Symptom-Dokumentation. Wir helfen Ihnen administrativ.' },
  { num: 4, title: 'MD-Gutachten + Bescheid', body: 'Wartezeit typisch 5 bis 25 Wochen ab Antrag.' },
  { num: 5, title: 'Bei Bewilligung', body: 'Pflegegrad gilt rückwirkend ab Antragsdatum. Leistungen rückwirkend erstattbar.' },
];
---

<PageLayout
  title="Pflegegrad-Antrag mit Profi-Hilfe Stuttgart | Katharis"
  description="Wir helfen Ihnen administrativ beim Pflegegrad-Antrag. Formulare ausfüllen, Begutachtung vorbereiten, Botengang. Bei Bewilligung rückwirkende Erstattung möglich."
>
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="bg-background py-16">
    <div class="max-w-content mx-auto px-4">
      <h1 class="text-4xl font-bold text-primary">Noch kein Pflegegrad? So beantragen Sie ihn.</h1>
      <p class="mt-4 text-lg text-primary/80">
        Wir helfen Ihnen <strong>administrativ</strong> beim Antrag bei der Pflegekasse. Bei Bewilligung
        kann die Pflegekasse Ihre Kosten ab Antragsdatum erstatten.
      </p>
      <p class="mt-2 text-sm text-primary/80">{hooks.geltungsbereich}</p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-pflegegrad-hero" />
      </div>
    </div>
  </section>

  <!-- Was ist Pflegegrad + Wer kann beantragen -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Was ist ein Pflegegrad?</h2>
    <p class="text-primary/80">
      Ein Pflegegrad zeigt, wie viel Hilfe ein Mensch im Alltag braucht. Es gibt fünf Stufen: Pflegegrad 1
      für geringe Beeinträchtigung, Pflegegrad 5 für schwerste Beeinträchtigung. Mit jedem Pflegegrad öffnet
      die Pflegekasse bestimmte Leistungen, die Ihre Mutter, Ihren Vater oder Sie selbst entlasten.
    </p>
    <p class="mt-4 text-primary/80">
      Wer keinen Antrag stellt, bekommt keine Leistung. Auch wenn der Bedarf da ist.
    </p>
  </section>

  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-6">Schritt-für-Schritt-Antrag</h2>
    <ol class="space-y-6">
      {steps.map((step) => (
        <li class="flex gap-4">
          <div class="flex-shrink-0 w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-lg">{step.num}</div>
          <div>
            <h3 class="font-bold text-primary text-lg">{step.title}</h3>
            <p class="mt-1 text-primary/80">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Wie wir Ihnen helfen</h2>
      <p class="font-bold text-primary mt-4">Was wir für Sie tun (administrative Antrags-Hilfe):</p>
      <ul class="mt-2 space-y-1 text-primary/80 list-disc list-inside">
        <li>Wir helfen Ihnen beim Ausfüllen des Pflegekassen-Antragsformulars.</li>
        <li>Wir bereiten den MD-Begutachtungs-Termin mit Ihnen vor.</li>
        <li>Bei schriftlicher Bevollmächtigung übernehmen wir den Botengang bei der Pflegekasse.</li>
      </ul>
      <p class="font-bold text-primary mt-4">Was wir nicht tun:</p>
      <ul class="mt-2 space-y-1 text-primary/80 list-disc list-inside">
        <li>Wir geben keine Beratung zu Leistungs-Ansprüchen oder Anspruchs-Höhe (Para 7a SGB XI).</li>
        <li>Wir begleiten keine Widersprüche gegen abgelehnte Bescheide (juristische Vertretung).</li>
      </ul>
      <p class="mt-4 text-sm text-primary/70">
        <strong>Inhaltliche Pflegeberatung</strong> bekommen Sie kostenlos beim Pflegestützpunkt in Ihrem Stadtbezirk.
        <strong>Bei Widerspruch</strong> vermitteln wir an Pflegestützpunkt oder Sozialrechts-Anwalt.
      </p>
    </div>
  </section>

  <!-- Rückwirkende Erstattung -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Rückwirkende Erstattung erklärt</h2>
    <p class="text-primary/80">
      Pflegegrad-Bewilligungen wirken rückwirkend ab Antragsdatum. Das bedeutet konkret:
    </p>
    <ol class="mt-4 space-y-2 text-primary/80 list-decimal list-inside">
      <li>Sie stellen den Antrag heute.</li>
      <li>Die Pflegekasse braucht typisch acht bis zwölf Wochen für die Entscheidung.</li>
      <li>In dieser Wartezeit können Sie schon Entlastungsleistungen in Anspruch nehmen.</li>
      <li>Bei Bewilligung werden diese Leistungen rückwirkend ab Antragsdatum erstattet.</li>
      <li>Bei Ablehnung gehen wir mit Ihnen den privaten Weg, transparent besprochen vor Beginn.</li>
    </ol>
  </section>

  <!-- FAQ -->
  <section class="py-12 bg-background">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-6">Häufige Fragen</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="border border-primary/20 rounded-lg p-4 bg-white">
            <summary class="font-bold text-primary cursor-pointer">{faq.question}</summary>
            <p class="mt-3 text-primary/80 text-sm">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Para 7a-Scope-Hinweis (3-fach redundant: Hero + Block "Wie wir helfen" + hier) -->
  <section class="py-8 bg-primary/5">
    <div class="max-w-content mx-auto px-4">
      <p class="text-sm text-primary/80">
        <strong>Scope-Hinweis:</strong> Wir leisten administrative Unterstützung beim Pflegegrad-Antragsprozess.
        Wir leisten keine Pflegeberatung im Sinne von Paragraph 7a SGB XI. Pflegeberatung ist Aufgabe der
        Pflegestützpunkte und qualifizierter Pflegeberater. Pflegekassen-Entscheidungen sind individuell.
        Wir geben keine Rechtsberatung. Die finale Bewilligung liegt bei Ihrer Pflegekasse.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-background">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-primary">Bereit für den ersten Schritt?</h2>
      <p class="mt-4 text-primary/80">
        Wir helfen Ihnen kostenlos im Erstgespräch zu verstehen, ob ein Pflegegrad-Antrag in Ihrer Situation
        Sinn macht und welche nächsten Schritte für Sie stimmen.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8 justify-center">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-pflegegrad-final" />
      </div>
    </div>
  </section>
</PageLayout>
