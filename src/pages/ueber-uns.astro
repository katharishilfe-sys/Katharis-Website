---
import PageLayout from '@layouts/PageLayout.astro';
import { initiatoren, trustIndikatoren, kontakt } from '@data/content';
---

<PageLayout
  title="Ueber Katharis - Initiator Daniel Altenhof | Stuttgart"
  description="Daniel Altenhof und Kemal David Guelcue als Initiatoren von Katharis. Spezialist fuer Entlastungsleistungen in komplexen Pflegefaellen, Stuttgart und LK Boeblingen."
>
  <section class="bg-background py-16">
    <div class="max-w-content mx-auto px-4">
      <h1 class="text-4xl font-bold text-primary">Wer hinter Katharis steht</h1>
      <p class="mt-4 text-lg text-primary/80">
        Spezialist fuer Entlastungsleistungen fuer Pflegebeduerftige in komplexen Faellen. Anerkannt nach Paragraph 45a SGB XI fuer Stadt Stuttgart und Landkreis Boeblingen.
      </p>
    </div>
  </section>

  <section class="py-12 max-w-content mx-auto px-4">
    {initiatoren.map((person) => (
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-primary">{person.name}, {person.rolle}</h2>
        <p class="mt-4 text-primary/80">{person.bio}</p>
      </div>
    ))}
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4 text-center">
      <p class="text-4xl font-bold text-accent-dark">{trustIndikatoren.bilanzZahl}+</p>
      <p class="mt-2 text-primary/80">{trustIndikatoren.bilanzText}.</p>
      <p class="mt-1 text-sm text-primary/60">{trustIndikatoren.team}.</p>
    </div>
  </section>

  <section class="py-16 bg-background text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary">Sprechen wir.</h2>
      <a href={`tel:${kontakt.telefonHref}`} class="inline-block mt-6 px-6 py-3 rounded-full font-bold text-white bg-accent-dark hover:opacity-90">Jetzt anrufen</a>
    </div>
  </section>
</PageLayout>
