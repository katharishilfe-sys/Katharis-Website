---
import PageLayout from '@layouts/PageLayout.astro';
import { hooks, kontakt } from '@data/content';
import { generateLocalBusinessSchema, generateBreadcrumbListSchema } from '@lib/schema-org';
import CallCTA from '@components/CallCTA';
import RueckrufButton from '@components/RueckrufButton';

const localBusinessSchema = generateLocalBusinessSchema({ areaServed: ['Landkreis Böblingen'] });
const breadcrumbSchema = generateBreadcrumbListSchema([
  { name: 'Start', url: 'https://katharis.de/' },
  { name: 'Standorte', url: 'https://katharis.de/standorte/' },
  { name: 'Böblingen', url: 'https://katharis.de/standorte/boeblingen/' },
]);
---

<PageLayout
  title="Katharis in Böblingen - operative Zentrale"
  description="Anerkannt nach Para 45a SGB XI für den gesamten Landkreis Böblingen. Operative Zentrale Olgastraße 8."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="bg-background py-16">
    <div class="max-w-content mx-auto px-4">
      <p class="text-sm text-primary/80">
        <a href="/" class="underline">Start</a> &rsaquo; <a href="/standorte/" class="underline">Standorte</a> &rsaquo; Böblingen
      </p>
      <h1 class="text-4xl font-bold text-primary mt-4">Katharis in Böblingen - operative Zentrale</h1>
      <p class="mt-4 text-lg text-primary/80">{hooks.master}</p>
      <p class="mt-2 text-sm text-primary/80">Anerkannt nach Para 45a SGB XI für den gesamten Landkreis Böblingen.</p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-boeblingen-hero" />
      </div>
    </div>
  </section>

  <!-- Was wir in Böblingen anbieten -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Was wir in Böblingen anbieten</h2>
    <p class="text-primary/80">
      Böblingen ist unsere operative Zentrale. Von hier aus bedienen wir Stadt Stuttgart und den gesamten
      Landkreis Böblingen mit komplexen Entlastungsleistungen: Messie-Hilfe, Vollräumungen vor dem Heimumzug,
      Vermieter-Übergabe besenrein.
    </p>
  </section>

  <!-- Adresse -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Adresse und Erreichbarkeit</h2>
      <div class="bg-background/50 p-6 rounded-xl">
        <p class="text-primary/80">
          <strong>Operative Zentrale:</strong><br />
          {kontakt.adresse.operativeZentrale.strasse}<br />
          {kontakt.adresse.operativeZentrale.plz} {kontakt.adresse.operativeZentrale.ort}
        </p>
        <p class="text-primary/80 mt-4">
          <strong>Telefon:</strong> <a href={`tel:${kontakt.telefonHref}`} class="hover:underline text-accent-dark">{kontakt.telefonAnzeige}</a><br />
          <strong>Email:</strong> <a href={`mailto:${kontakt.email}`} class="hover:underline text-accent-dark">{kontakt.email}</a><br />
          <strong>Geschäftszeiten:</strong> {kontakt.oeffnungszeiten}
        </p>
      </div>
    </div>
  </section>

  <!-- Einzugsgebiet -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Einzugsgebiet Landkreis Böblingen</h2>
    <p class="text-primary/80">
      Wir bedienen alle Gemeinden im Landkreis Böblingen, darunter Sindelfingen, Leonberg, Herrenberg,
      Weil der Stadt, Holzgerlingen, Schönaich und weitere. Anfahrt aus Böblingen typisch 5 bis 25 Minuten.
    </p>
    <p class="mt-4 text-primary/80">
      Pflegekassen-Direkt-Abrechnung greift im Landkreis Böblingen vollumfänglich. Bei Sub-Standorten wie
      Sindelfingen, Leonberg oder Herrenberg klären wir die Bescheid-Spezifika gegebenenfalls vor
      Auftragsbeginn mit Ihrer Pflegekasse.
    </p>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-background text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary">Sprechen wir.</h2>
      <div class="flex flex-col sm:flex-row gap-3 mt-6 justify-center">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-boeblingen-final" />
      </div>
    </div>
  </section>
</PageLayout>
