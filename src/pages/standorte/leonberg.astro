---
import PageLayout from '@layouts/PageLayout.astro';
import { hooks } from '@data/content';
import { generateLocalBusinessSchema, generateFAQPageSchema, generateBreadcrumbListSchema } from '@lib/schema-org';
import CallCTA from '@components/CallCTA';
import RueckrufButton from '@components/RueckrufButton';

const localBusinessSchema = generateLocalBusinessSchema({ areaServed: ['Leonberg', 'Landkreis Böblingen'] });

const faqs = [
  {
    question: 'Kommen Sie wirklich nach Leonberg?',
    answer:
      'Ja, regelmäßig. Anfahrt aus unserer operativen Zentrale Böblingen Olgastraße 8 typisch 18 bis 25 Minuten, je nach Verkehrslage auf der A8 und Strecke durch das Heckengäu.',
  },
  {
    question: 'Welche Pflegestützpunkte sind für Leonberg zuständig?',
    answer:
      'Der Pflegestützpunkt Landkreis Böblingen in Böblingen ist auch für Leonberger Klienten zuständig, neutral und kostenfrei. Bundesweit ist die Compass Pflegeberatung unter 0800 101 88 00 erreichbar, auch mit Hausbesuch in Leonberg.',
  },
  {
    question: 'Bedienen Sie auch Eltingen und Höfingen?',
    answer:
      'Ja, alle Leonberger Stadtteile sind Teil unseres Anerkennungs-Gebiets. Eltingen, Höfingen, Ramtel, Warmbronn und Gebersheim erreichen wir aus Böblingen typisch in 20 bis 28 Minuten.',
  },
  {
    question: 'Wie schnell können Sie nach Leonberg kommen?',
    answer:
      'Vor-Ort-Termin innerhalb von 3 bis 7 Tagen. Bei Vermieter-Druck oder akuter Verwahrlosung priorisieren wir. Erstgespräch am Telefon noch am gleichen oder nächsten Werktag.',
  },
];

const faqSchema = generateFAQPageSchema(faqs);

const breadcrumbSchema = generateBreadcrumbListSchema([
  { name: 'Start', url: 'https://katharis.de/' },
  { name: 'Standorte', url: 'https://katharis.de/standorte/' },
  { name: 'Leonberg', url: 'https://katharis.de/standorte/leonberg/' },
]);
---

<PageLayout
  title="Messie-Hilfe und Vollräumung Leonberg | Katharis"
  description="Anerkannter Anbieter für Entlastungsleistungen in Leonberg. §45a SGB XI für den Landkreis Böblingen. Pflegekassen-Direktabrechnung, Vor-Ort-Termin in 3-7 Tagen ab Böblingen."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="bg-background py-16">
    <div class="max-w-content mx-auto px-4">
      <p class="text-sm text-primary/80">
        <a href="/" class="underline">Start</a> &rsaquo; <a href="/standorte/" class="underline">Standorte</a> &rsaquo; Leonberg
      </p>
      <h1 class="text-4xl font-bold text-primary mt-4">Entlastungsleistungen in Leonberg</h1>
      <p class="mt-4 text-lg text-primary/80">{hooks.master}</p>
      <p class="mt-2 text-sm text-primary/80">
        Anerkannt nach Paragraph 45a SGB XI für den gesamten Landkreis Böblingen, Leonberg
        eingeschlossen. Operative Zentrale Böblingen, Anfahrt typisch 18 bis 25 Minuten.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-leonberg-hero" />
      </div>
    </div>
  </section>

  <!-- Was wir in Leonberg leisten -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Was wir in Leonberg leisten</h2>
    <p class="text-primary/80">
      Leonberg liegt am westlichen Rand des Stuttgarter Ballungsraums, mit Anbindung über die A8
      nach Stuttgart-West und über die B295 ins Heckengäu. Wir sind in Leonberg regelmäßig im
      Einsatz mit Schwerpunkt auf komplexen Entlastungsleistungen:
    </p>
    <ul class="mt-3 space-y-2 text-primary/80 list-disc list-inside">
      <li><strong>Messie-Hilfe</strong> bei Verwahrlosung der Wohnung, mit Tiefenreinigung und diskreter Vor-Ort-Begehung</li>
      <li><strong>Vollräumung vor dem Pflegeheim-Umzug</strong> mit Erbstück-Sicherung und besenreiner Vermieter-Übergabe</li>
      <li><strong>Pflegekassen-Direktabrechnung</strong> bei vorhandenem Pflegegrad, ohne Vorkasse durch die Familie</li>
      <li><strong>Hygiene- und Geruchsbeseitigung</strong>, vor denen Standard-Reinigungsdienste zurückschrecken</li>
    </ul>
    <p class="mt-4 text-primary/80">
      In Leonberg arbeiten wir regelmäßig in der historischen Altstadt um den Marktplatz und den
      Pomeranzengarten, in Eltingen, in den Wohngebieten Richtung Höfingen sowie in Warmbronn und
      Gebersheim. Anfahrt aus Böblingen typisch 18 bis 25 Minuten je nach A8-Verkehr.
    </p>
  </section>

  <!-- Stadtteile + Anfahrt -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Stadtteile und Anfahrtszeiten</h2>
      <ul class="mt-3 space-y-1 text-primary/80 list-disc list-inside">
        <li>Leonberg Mitte und Altstadt: 18 bis 22 Minuten ab Böblingen</li>
        <li>Eltingen: 18 bis 22 Minuten</li>
        <li>Höfingen: 20 bis 25 Minuten</li>
        <li>Ramtel: 20 bis 25 Minuten</li>
        <li>Warmbronn und Gebersheim: 22 bis 28 Minuten</li>
        <li>Anbindung Stuttgart-West über A8: zusätzlich 10 bis 20 Minuten</li>
      </ul>
      <p class="mt-4 text-primary/80">
        Pflegekassen-Direktabrechnung greift in allen Leonberger Stadtteilen. Auch in den nördlichen
        Teilbezirken Höfingen und Ramtel rechnen wir nach Paragraph 45a SGB XI direkt mit der
        Pflegekasse ab.
      </p>
    </div>
  </section>

  <!-- Pflegekassen-Direktabrechnung -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Pflegekassen-Direktabrechnung in Leonberg</h2>
    <p class="text-primary/80">
      Leonberg gehört zum Landkreis Böblingen. Unsere Anerkennung nach Paragraph 45a SGB XI deckt
      Leonberg vollständig ab. Bei vorhandenem Pflegegrad ab 1 rechnen wir die Leistung direkt mit
      Ihrer Pflegekasse ab, Sie strecken nichts vor.
    </p>
    <p class="mt-4 text-primary/80">
      Welche Töpfe für Ihre Situation passen, klären wir kostenlos am Telefon. Hintergrund auf
      <a href="/pflegekasse/" class="underline text-accent-dark">Pflegekassen-Übersicht</a> und im
      <a href="/ratgeber/pflegekasse-entlastung/" class="underline text-accent-dark">Ratgeber Pflegekasse und Entlastung</a>.
    </p>
  </section>

  <!-- Beratung vor Ort -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Kostenlose Pflegeberatung in Leonberg</h2>
      <p class="text-primary/80">
        Inhaltliche Pflegekassen-Beratung erhalten Sie kostenlos und neutral bei:
      </p>
      <ul class="mt-3 space-y-1 text-primary/80 list-disc list-inside">
        <li><strong>Pflegestützpunkt Landkreis Böblingen</strong> in Böblingen, zuständig für ganz Leonberg</li>
        <li><strong>Compass Pflegeberatung</strong> bundesweit unter 0800 101 88 00, auch mit Hausbesuch in Leonberg</li>
        <li>Ihre Hausärztin oder Ihr Hausarzt als erste Anlaufstelle</li>
      </ul>
      <p class="mt-4 text-primary/80">
        Wir vermitteln Ihnen gerne den richtigen Kontakt.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-6">Häufige Fragen aus Leonberg</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
          <summary class="font-bold text-primary cursor-pointer">{faq.question}</summary>
          <p class="mt-3 text-primary/80 text-sm">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-background text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary">Sprechen wir.</h2>
      <p class="mt-4 text-primary/80">Im kostenlosen Erstgespräch klären wir Ihre Pflegekassen-Optionen.</p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8 justify-center">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-leonberg-final" />
      </div>
    </div>
  </section>
</PageLayout>
