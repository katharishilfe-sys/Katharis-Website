---
import PageLayout from '@layouts/PageLayout.astro';
import { hooks } from '@data/content';
import { generateLocalBusinessSchema, generateBreadcrumbListSchema } from '@lib/schema-org';
import CallCTA from '@components/CallCTA';
import RueckrufButton from '@components/RueckrufButton';

const localBusinessSchema = generateLocalBusinessSchema({ areaServed: ['Leonberg', 'Landkreis Böblingen'] });
const breadcrumbSchema = generateBreadcrumbListSchema([
  { name: 'Start', url: 'https://katharis.de/' },
  { name: 'Standorte', url: 'https://katharis.de/standorte/' },
  { name: 'Leonberg', url: 'https://katharis.de/standorte/leonberg/' },
]);
---

<PageLayout
  title="Entlastungsleistungen Leonberg | Katharis"
  description="Spezialist für Entlastungsleistungen in Leonberg. Anerkannt nach Para 45a SGB XI für den Landkreis Böblingen. Pflegekassen-Direktabrechnung."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="bg-background py-16">
    <div class="max-w-content mx-auto px-4">
      <p class="text-sm text-primary/80">
        <a href="/" class="underline">Start</a> &rsaquo; <a href="/standorte/" class="underline">Standorte</a> &rsaquo; Leonberg
      </p>
      <h1 class="text-4xl font-bold text-primary mt-4">Entlastungsleistungen in Leonberg</h1>
      <p class="mt-4 text-lg text-primary/80">{hooks.master}</p>
      <p class="mt-2 text-sm text-primary/80">
        Anerkannt nach Paragraph 45a SGB XI für den gesamten Landkreis Böblingen, Leonberg eingeschlossen.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-leonberg-hero" />
      </div>
    </div>
  </section>

  <!-- Was wir in Leonberg anbieten -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Was wir in Leonberg leisten</h2>
    <p class="text-primary/80">
      Leonberg liegt am westlichen Rand von Stuttgart, mit guter Anbindung Richtung Böblingen. Wir sind
      regelmäßig in Leonberg im Einsatz, von der Altstadt um das Pomeranzengarten-Schloss bis Eltingen
      und Höfingen. Schwerpunkt sind komplexe Entlastungsleistungen, vor denen Standard-Anbieter
      zurückschrecken: Messie-Wohnungen, Vollräumungen vor knapper Heimumzug-Frist, Tiefenreinigung mit
      Hygieneschulung.
    </p>
    <p class="mt-4 text-primary/80">
      Anfahrt aus unserer Zentrale Böblingen: typisch 18 bis 25 Minuten. Vor-Ort-Begehung kostenlos,
      Kostenrahmen besprechen wir transparent vor Auftragsbeginn.
    </p>
  </section>

  <!-- Pflegekassen-Direktabrechnung -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Pflegekassen-Direktabrechnung in Leonberg</h2>
      <p class="text-primary/80">
        Leonberg gehört zum Landkreis Böblingen. Unsere Anerkennung nach Paragraph 45a SGB XI deckt auch
        Leonberg ab. Bei vorhandenem Pflegegrad ab 1 rechnen wir die Leistung direkt mit Ihrer Pflegekasse
        ab, Sie müssen die Kosten nicht vorstrecken.
      </p>
      <p class="mt-4 text-primary/80">
        Welche Pflegekassen-Töpfe für Ihre Situation greifen, besprechen wir kostenlos am Telefon im
        Erstgespräch. Mehr zum Hintergrund auf <a href="/pflegekasse/" class="underline text-accent-dark">Pflegekassen-Leistungen</a>
        und <a href="/pflegegrad-antrag/" class="underline text-accent-dark">Pflegegrad-Antrag</a>.
      </p>
    </div>
  </section>

  <!-- Beratung vor Ort -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Kostenlose Pflegeberatung in Leonberg</h2>
    <p class="text-primary/80">
      Für inhaltliche Pflegekassen-Beratung verweisen wir gerne an den <strong>Pflegestützpunkt Landkreis
      Böblingen</strong> in Böblingen. Der Pflegestützpunkt berät kostenlos und neutral, auch für Klienten
      aus Leonberg. Wir vermitteln Ihnen den richtigen Kontakt.
    </p>
    <p class="mt-4 text-primary/80">
      Bundesweit ist die <strong>Compass Pflegeberatung</strong> kostenlos erreichbar:
      0800 101 88 00. Compass-Berater bieten auch Hausbesuche in Leonberg an.
    </p>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-background text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary">Sprechen wir.</h2>
      <p class="mt-4 text-primary/80">Im kostenlosen Erstgespräch klären wir Ihre Pflegekassen-Optionen.</p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8 justify-center">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-leonberg-final" />
      </div>
    </div>
  </section>
</PageLayout>
