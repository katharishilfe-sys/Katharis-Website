---
import PageLayout from '@layouts/PageLayout.astro';
import { kontakt } from '@data/content';
---

<PageLayout
  title="Katharis in Herrenberg"
  description="Operative Bedienung Herrenberg aus Böblingen. Para 45a-Anerkennung in Klärung."
  noindex={true}
>
  <section class="bg-background py-16 max-w-content mx-auto px-4">
    <h1 class="text-4xl font-bold text-primary">Katharis in Herrenberg</h1>
    <div class="mt-6 p-4 bg-accent/10 rounded-xl text-sm text-primary/80">
      <strong>Hinweis:</strong> Wir sind operativ in Herrenberg tätig. Die formelle Anerkennung nach Para 45a SGB XI
      für den Landkreis Böblingen umfasst auch Herrenberg; eine spezifische Bescheid-Validierung steht noch aus.
    </div>
    <a href={`tel:${kontakt.telefonHref}`} class="inline-block mt-8 px-6 py-3 rounded-full font-bold text-white bg-accent-dark hover:opacity-90">Jetzt anrufen</a>
  </section>
</PageLayout>
