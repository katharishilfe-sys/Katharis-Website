---
import PageLayout from '@layouts/PageLayout.astro';
import { hooks } from '@data/content';
import { generateLocalBusinessSchema, generateFAQPageSchema, generateBreadcrumbListSchema } from '@lib/schema-org';
import CallCTA from '@components/CallCTA';
import RueckrufButton from '@components/RueckrufButton';

const localBusinessSchema = generateLocalBusinessSchema({ areaServed: ['Herrenberg', 'Landkreis Böblingen'] });

const faqs = [
  {
    question: 'Kommen Sie wirklich nach Herrenberg?',
    answer:
      'Ja, regelmäßig. Anfahrt aus unserer operativen Zentrale Böblingen Olgastraße 8 typisch 20 bis 28 Minuten, je nach Verkehrslage auf der A81 und Strecke durch das Gäu.',
  },
  {
    question: 'Welche Pflegestützpunkte sind für Herrenberg zuständig?',
    answer:
      'Der Pflegestützpunkt Landkreis Böblingen in Böblingen ist auch für Herrenberger Klienten zuständig, neutral und kostenfrei. Bundesweit ist die Compass Pflegeberatung unter 0800 101 88 00 erreichbar, auch mit Hausbesuch in Herrenberg.',
  },
  {
    question: 'Bedienen Sie auch Kuppingen, Mönchberg und Affstätt?',
    answer:
      'Ja, alle Herrenberger Stadtteile sind Teil unseres Anerkennungs-Gebiets. Kuppingen, Mönchberg, Affstätt und weitere Teilorte erreichen wir aus Böblingen typisch in 22 bis 30 Minuten.',
  },
  {
    question: 'Wie schnell können Sie nach Herrenberg kommen?',
    answer:
      'Vor-Ort-Termin innerhalb von 3 bis 7 Tagen. Bei Vermieter-Druck oder akuter Verwahrlosung priorisieren wir. Erstgespräch am Telefon noch am gleichen oder nächsten Werktag.',
  },
];

const faqSchema = generateFAQPageSchema(faqs);

const breadcrumbSchema = generateBreadcrumbListSchema([
  { name: 'Start', url: 'https://katharis.de/' },
  { name: 'Standorte', url: 'https://katharis.de/standorte/' },
  { name: 'Herrenberg', url: 'https://katharis.de/standorte/herrenberg/' },
]);
---

<PageLayout
  title="Messie-Hilfe und Vollräumung Herrenberg | Katharis"
  description="Anerkannter Anbieter für Entlastungsleistungen in Herrenberg. §45a SGB XI für den Landkreis Böblingen. Pflegekassen-Direktabrechnung, Vor-Ort-Termin in 3-7 Tagen ab Böblingen."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero -->
  <section class="bg-background py-16">
    <div class="max-w-content mx-auto px-4">
      <p class="text-sm text-primary/80">
        <a href="/" class="underline">Start</a> &rsaquo; <a href="/standorte/" class="underline">Standorte</a> &rsaquo; Herrenberg
      </p>
      <h1 class="text-4xl font-bold text-primary mt-4">Entlastungsleistungen in Herrenberg</h1>
      <p class="mt-4 text-lg text-primary/80">{hooks.master}</p>
      <p class="mt-2 text-sm text-primary/80">
        Anerkannt nach Paragraph 45a SGB XI für den gesamten Landkreis Böblingen, Herrenberg
        eingeschlossen. Operative Zentrale Böblingen, Anfahrt typisch 20 bis 28 Minuten.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-herrenberg-hero" />
      </div>
    </div>
  </section>

  <!-- Was wir in Herrenberg leisten -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Was wir in Herrenberg leisten</h2>
    <p class="text-primary/80">
      Herrenberg liegt am südlichen Rand des Landkreises Böblingen mit historischem Fachwerk-Kern
      und mehreren Teilorten mit eigenem Charakter. Wir sind in Herrenberg regelmäßig im Einsatz,
      mit Schwerpunkt auf komplexen Entlastungsleistungen:
    </p>
    <ul class="mt-3 space-y-2 text-primary/80 list-disc list-inside">
      <li><strong>Messie-Hilfe</strong> bei Verwahrlosung der Wohnung, mit Tiefenreinigung und diskreter Vor-Ort-Begehung</li>
      <li><strong>Heimumzug-Vollräumungen</strong> mit Erbstück-Sicherung und besenreiner Vermieter-Übergabe</li>
      <li><strong>Pflegekassen-Direktabrechnung</strong> bei vorhandenem Pflegegrad, ohne Vorkasse durch die Familie</li>
      <li><strong>Tiefenreinigung</strong> von Wohnungen, die normale Reinigungsdienste nicht übernehmen</li>
    </ul>
    <p class="mt-4 text-primary/80">
      In Herrenberg arbeiten wir in der Innenstadt rund um das historische Schickhardt-Areal, in
      Wohngebieten Richtung Reinhold-Schick-Platz und in den Teilorten Kuppingen, Mönchberg und
      Affstätt. Anfahrt aus Böblingen typisch 20 bis 28 Minuten je nach A81-Verkehr.
    </p>
  </section>

  <!-- Stadtteile + Anfahrt -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Stadtteile und Anfahrtszeiten</h2>
      <ul class="mt-3 space-y-1 text-primary/80 list-disc list-inside">
        <li>Herrenberg Mitte und Altstadt: 20 bis 24 Minuten ab Böblingen</li>
        <li>Kuppingen: 22 bis 28 Minuten</li>
        <li>Mönchberg: 22 bis 28 Minuten</li>
        <li>Affstätt: 22 bis 28 Minuten</li>
        <li>Anbindung zum Pflegestützpunkt Böblingen über A81: 20 bis 25 Minuten</li>
      </ul>
      <p class="mt-4 text-primary/80">
        Pflegekassen-Direktabrechnung greift in allen Herrenberger Stadtteilen. Auch in den
        Teilorten Kuppingen, Mönchberg und Affstätt rechnen wir nach Paragraph 45a SGB XI direkt
        mit der Pflegekasse ab.
      </p>
    </div>
  </section>

  <!-- Pflegekassen-Direktabrechnung -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Pflegekassen-Direktabrechnung in Herrenberg</h2>
    <p class="text-primary/80">
      Herrenberg gehört zum Landkreis Böblingen. Unsere Anerkennung nach Paragraph 45a SGB XI deckt
      Herrenberg vollumfänglich ab. Bei vorhandenem Pflegegrad ab 1 rechnen wir die Leistung direkt
      mit Ihrer Pflegekasse ab, Sie strecken nichts vor.
    </p>
    <p class="mt-4 text-primary/80">
      Welche Töpfe in Ihrer Situation greifen, klären wir kostenlos am Telefon. Hintergrund auf
      <a href="/pflegekasse/" class="underline text-accent-dark">Pflegekassen-Übersicht</a>,
      <a href="/pflegegrad-antrag/" class="underline text-accent-dark">Pflegegrad-Antrag</a>
      und im
      <a href="/ratgeber/pflegekasse-entlastung/" class="underline text-accent-dark">Ratgeber Pflegekasse und Entlastung</a>.
    </p>
  </section>

  <!-- Beratung vor Ort -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Kostenlose Pflegeberatung in Herrenberg</h2>
      <p class="text-primary/80">
        Inhaltliche Pflegekassen-Beratung ist kostenlos und neutral erhältlich bei:
      </p>
      <ul class="mt-3 space-y-1 text-primary/80 list-disc list-inside">
        <li><strong>Pflegestützpunkt Landkreis Böblingen</strong> in Böblingen, zuständig für ganz Herrenberg</li>
        <li><strong>Compass Pflegeberatung</strong> bundesweit unter 0800 101 88 00, auch mit Hausbesuch in Herrenberg</li>
        <li>Ihre Hausärztin oder Ihr Hausarzt als erste Anlaufstelle</li>
      </ul>
      <p class="mt-4 text-primary/80">
        Wir vermitteln Ihnen gerne den richtigen Kontakt.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-6">Häufige Fragen aus Herrenberg</h2>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
          <summary class="font-bold text-primary cursor-pointer">{faq.question}</summary>
          <p class="mt-3 text-primary/80 text-sm">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Vertiefende Ratgeber -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Vertiefende Ratgeber</h2>
    <ul class="space-y-1 text-primary/80 list-disc list-inside text-sm">
      <li><a href="/ratgeber/pflegekasse-entlastung/" class="underline text-accent-dark">Pflegekassen-Töpfe 2026</a></li>
      <li><a href="/ratgeber/entlastungsbetrag-richtig-nutzen/" class="underline text-accent-dark">Entlastungsbetrag 131 € richtig nutzen</a></li>
      <li><a href="/ratgeber/pflegegrad-1-was-zahlt-die-kasse/" class="underline text-accent-dark">Pflegegrad 1 – was zahlt die Kasse?</a></li>
      <li><a href="/ratgeber/pflegekasse-direktabrechnung/" class="underline text-accent-dark">Direktabrechnung erklärt</a></li>
      <li><a href="/ratgeber/pflegekasse-ablehnung-widerspruch/" class="underline text-accent-dark">Pflegekasse abgelehnt – Widerspruch einlegen</a></li>
      <li><a href="/ratgeber/heimumzug-kosten/" class="underline text-accent-dark">Heimumzug und Kosten</a></li>
      <li><a href="/ratgeber/messie-syndrom/" class="underline text-accent-dark">Messie-Syndrom verstehen</a></li>
      <li><a href="/standorte/" class="underline text-accent-dark font-bold">Alle Standorte</a></li>
    </ul>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-background text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary">Sprechen wir.</h2>
      <p class="mt-4 text-primary/80">Im kostenlosen Erstgespräch klären wir Ihre Pflegekassen-Optionen.</p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8 justify-center">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-herrenberg-final" />
      </div>
    </div>
  </section>
</PageLayout>
