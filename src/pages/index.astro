---
import PageLayout from '@layouts/PageLayout.astro';
import { hooks, services, trustIndikatoren } from '@data/content';
import { generateLocalBusinessSchema, generateWebSiteSchema, generateFAQPageSchema } from '@lib/schema-org';
import CallCTA from '@components/CallCTA';
import RueckrufButton from '@components/RueckrufButton';

const localBusinessSchema = generateLocalBusinessSchema();
const webSiteSchema = generateWebSiteSchema();

const homeFaqs = [
  {
    question: 'Was kostet das?',
    answer:
      'Im kostenlosen Erstgespräch klären wir, ob Ihre Pflegekasse die Kosten übernimmt. Bei Pflegegrad ab 1 können wir den Entlastungsbetrag von 131 Euro pro Monat nutzen, bei Pflegegrad ab 2 kommen weitere Töpfe dazu. Wenn die Pflegekasse nicht alles trägt, besprechen wir transparent welche Optionen es gibt.',
  },
  {
    question: 'Wie schnell können Sie kommen?',
    answer:
      'Erstgespräch am Telefon meist innerhalb von 24 Stunden. Vor-Ort-Termin typisch innerhalb einer Woche. Bei akutem Termin-Druck (zum Beispiel Vermieter-Frist) sprechen Sie uns offen an.',
  },
  {
    question: 'Wie diskret arbeiten Sie?',
    answer:
      'Neutrale Fahrzeuge ohne auffällige Werbung. Unauffällige Kleidung. Wenn gewünscht, arbeiten wir zu Tageszeiten, die wenig Aufmerksamkeit auf sich ziehen. Niemand außerhalb des Auftrags muss wissen, dass wir bei Ihnen sind.',
  },
  {
    question: 'Wer zahlt das?',
    answer:
      'Bei vorhandenem Pflegegrad rechnen wir direkt mit der Pflegekasse ab. Bei fehlendem Pflegegrad helfen wir administrativ beim Antrag und können parallel die Entlastungsleistung erbringen, die bei Bewilligung rückwirkend ab Antragsdatum erstattet wird.',
  },
  {
    question: 'Was bedeutet die Anerkennung nach Paragraph 45a SGB XI?',
    answer:
      'Wir sind als Anbieter zur Unterstützung im Alltag von der Anerkennungs-Stelle des Landes Baden-Württemberg für Stadt Stuttgart und Landkreis Böblingen anerkannt. Das heißt: wir können Entlastungsleistungen direkt mit Ihrer Pflegekasse abrechnen, ohne dass Sie das Geld vorstrecken müssen.',
  },
  {
    question: 'Wie unterscheidet sich Ihre Hilfe von der Pflegeberatung im Pflegestützpunkt?',
    answer:
      'Der Pflegestützpunkt berät Sie inhaltlich zu Ihren Pflegekassen-Ansprüchen, kostenlos und neutral. Wir setzen die operative Arbeit um: Antrag administrativ ausfüllen, Begutachtung vorbereiten, Wohnung räumen, reinigen, übergeben. Beide Rollen ergänzen sich, ersetzen sich nicht.',
  },
];

const homeFaqSchema = generateFAQPageSchema(homeFaqs);
---

<PageLayout
  title="Katharis - Pflegekassen-Entlastung Stuttgart und LK Böblingen"
  description="Spezialist für Entlastungsleistungen bei komplexen Pflegefällen. Anerkannt nach Para 45a SGB XI. Bis zu 100 Prozent Kostenübernahme möglich. Diskret und würdevoll."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(homeFaqSchema)} />

  <!-- Hero -->
  <section class="bg-background py-16 md:py-24">
    <div class="max-w-content mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-primary leading-tight">
        {hooks.master}
      </h1>
      <p class="mt-3 text-base md:text-lg text-primary/70">
        {hooks.geltungsbereich}
      </p>
      <p class="mt-6 text-lg md:text-xl text-primary/80 max-w-2xl mx-auto">
        {hooks.sekundaer}
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8 justify-center">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-home-hero" />
      </div>
    </div>
  </section>

  <!-- Drei Eingangs-Türen -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary text-center mb-12">Wie wir Ihnen helfen</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a
          href={services.messieHilfe.slug}
          class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow"
        >
          <h3 class="text-xl font-bold text-primary">{services.messieHilfe.karteHeadline}</h3>
          <p class="mt-3 text-primary/80 text-sm">{services.messieHilfe.karteText}</p>
          <p class="mt-4 text-accent-dark font-bold text-sm">Mehr über Messie-Hilfe &rarr;</p>
        </a>
        <a
          href={services.vorDemHeimumzug.slug}
          class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow"
        >
          <h3 class="text-xl font-bold text-primary">{services.vorDemHeimumzug.karteHeadline}</h3>
          <p class="mt-3 text-primary/80 text-sm">{services.vorDemHeimumzug.karteText}</p>
          <p class="mt-4 text-accent-dark font-bold text-sm">Mehr über Heimumzug-Vollräumung &rarr;</p>
        </a>
        <a
          href="/pflegegrad-antrag/"
          class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-shadow"
        >
          <h3 class="text-xl font-bold text-primary">Noch kein Pflegegrad?</h3>
          <p class="mt-3 text-primary/80 text-sm">
            Wir helfen Ihnen administrativ beim Antrag bei der Pflegekasse: Formulare ausfüllen,
            MD-Begutachtung vorbereiten, Botengang. Bei Bewilligung kann die Pflegekasse Ihre Kosten
            ab Antragsdatum erstatten.
          </p>
          <p class="mt-4 text-accent-dark font-bold text-sm">Pflegegrad beantragen &rarr;</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust-Sektion -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div>
        <p class="text-4xl font-bold text-accent-dark">&sect;45a</p>
        <p class="mt-2 text-primary/80">Anerkannt nach Para 45a SGB XI für Stadt Stuttgart und Landkreis Böblingen.</p>
      </div>
      <div>
        <p class="text-4xl font-bold text-accent-dark">3 Mio &euro;</p>
        <p class="mt-2 text-primary/80">Versichert für Sach- und Personenschäden ohne Selbstbeteiligung.</p>
      </div>
      <div>
        <p class="text-4xl font-bold text-accent-dark">{trustIndikatoren.bilanzZahl}+</p>
        <p class="mt-2 text-primary/80">{trustIndikatoren.bilanzText}.</p>
      </div>
    </div>
  </section>

  <!-- Für wen geeignet -->
  <section class="py-16 bg-background">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary text-center mb-10">Für wen wir da sind</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-xl">
          <h3 class="font-bold text-primary text-lg">Angehörige in akuter Belastung</h3>
          <p class="mt-3 text-primary/80 text-sm">
            Wenn die Wohnung Ihrer Mutter oder Ihres Vaters über Jahre verwahrlost ist und Sie nicht mehr
            wissen wo anfangen. Wir kommen, schauen, ordnen ein, machen die Arbeit. Ohne Vorwurf, ohne Druck.
          </p>
        </div>
        <div class="bg-white p-6 rounded-xl">
          <h3 class="font-bold text-primary text-lg">Sozialdienste und Pflegestützpunkte</h3>
          <p class="mt-3 text-primary/80 text-sm">
            Wenn ein Klient bei Ihnen sitzt mit einem Wohn-Problem das Sie nicht mit Standard-Anbietern
            lösen können. Wir nehmen den Fall, dokumentieren transparent, rechnen mit der Pflegekasse direkt
            ab.
          </p>
        </div>
        <div class="bg-white p-6 rounded-xl">
          <h3 class="font-bold text-primary text-lg">Pflegeheime und Heim-Sozialdienste</h3>
          <p class="mt-3 text-primary/80 text-sm">
            Wenn ein neuer Bewohner einzieht und seine alte Wohnung räumen muss, oft mit knapper
            Vermieter-Frist. Wir koordinieren direkt mit Ihnen und mit Angehörigen. Auch
            Sterbefall-Räumungen.
          </p>
        </div>
        <div class="bg-white p-6 rounded-xl">
          <h3 class="font-bold text-primary text-lg">Vermieter und Hausverwaltungen</h3>
          <p class="mt-3 text-primary/80 text-sm">
            Wenn ein Mieter mit Pflegegrad ausziehen muss und die Wohnung in einem Zustand ist der über
            normale Reinigung hinausgeht. Wir liefern besenrein, mit Pflegekassen-Direkt-Abrechnung wenn
            möglich.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Was uns unterscheidet -->
  <section class="py-16 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary text-center mb-10">Was uns unterscheidet</h2>
      <div class="space-y-6">
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 bg-accent-dark/10 text-accent-dark rounded-full flex items-center justify-center font-bold">1</div>
          <div>
            <h3 class="font-bold text-primary">Pflegekassen-Direktabrechnung als Standard</h3>
            <p class="mt-1 text-primary/80 text-sm">Über unsere Anerkennung nach Paragraph 45a SGB XI. Sie strecken nichts vor.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 bg-accent-dark/10 text-accent-dark rounded-full flex items-center justify-center font-bold">2</div>
          <div>
            <h3 class="font-bold text-primary">Diskrete und würdevolle Arbeitsweise</h3>
            <p class="mt-1 text-primary/80 text-sm">Neutrale Fahrzeuge, unauffällige Kleidung, Arbeit ohne Wertung.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 bg-accent-dark/10 text-accent-dark rounded-full flex items-center justify-center font-bold">3</div>
          <div>
            <h3 class="font-bold text-primary">Spezialisierung auf komplexe Fälle</h3>
            <p class="mt-1 text-primary/80 text-sm">Wir nehmen Fälle, vor denen Standard-Anbieter zurückschrecken: Hygiene-Probleme, Verwahrlosung, knappe Heimumzug-Fristen.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="flex-shrink-0 w-10 h-10 bg-accent-dark/10 text-accent-dark rounded-full flex items-center justify-center font-bold">4</div>
          <div>
            <h3 class="font-bold text-primary">Antrags-Hilfe wenn der Pflegegrad noch fehlt</h3>
            <p class="mt-1 text-primary/80 text-sm">Administrative Antrags-Hilfe, Begutachtungs-Vorbereitung, Botengang. Inhaltliche Pflegeberatung verweisen wir an den Pflegestützpunkt.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- So gehen wir vor (3 Schritte) -->
  <section class="py-16 bg-background">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary text-center mb-12">So gehen wir vor</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-lg mb-4">1</div>
          <h3 class="text-xl font-bold text-primary">Kostenloses Erstgespräch am Telefon</h3>
          <p class="mt-3 text-primary/80 text-sm">Sie rufen uns an oder fordern einen Rückruf an. Wir hören zu, klären Ihre Situation, erläutern mögliche Pflegekassen-Optionen. Das Gespräch ist kostenlos und unverbindlich.</p>
        </div>
        <div class="bg-white p-6 rounded-xl">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-lg mb-4">2</div>
          <h3 class="text-xl font-bold text-primary">Vor-Ort-Termin und Pflegekassen-Klärung</h3>
          <p class="mt-3 text-primary/80 text-sm">Wir kommen zu Ihnen, schauen uns die Wohnung an, besprechen Auftragsumfang und Termin-Wunsch. Bei Pflegegrad klären wir die Direkt-Abrechnung mit Ihrer Pflegekasse.</p>
        </div>
        <div class="bg-white p-6 rounded-xl">
          <div class="w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-lg mb-4">3</div>
          <h3 class="text-xl font-bold text-primary">Diskrete Durchführung mit Pflegekassen-Direktabrechnung</h3>
          <p class="mt-3 text-primary/80 text-sm">Wir arbeiten unauffällig, ohne Wertung, mit neutralen Fahrzeugen. Bei Pflegekassen-Direkt-Abrechnung tragen Sie keine Kosten. Endzustand: leere und besenreine Wohnung.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ-Sektion -->
  <section class="py-16 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary text-center mb-8">Häufige Fragen</h2>
      <div class="space-y-3">
        <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
          <summary class="font-bold text-primary cursor-pointer">Was kostet das?</summary>
          <p class="mt-3 text-primary/80 text-sm">Im kostenlosen Erstgespräch klären wir, ob Ihre Pflegekasse die Kosten übernimmt. Bei Pflegegrad ab 1 können wir den Entlastungsbetrag von 131 Euro pro Monat nutzen, bei Pflegegrad ab 2 kommen weitere Töpfe dazu. Wenn die Pflegekasse nicht alles trägt, besprechen wir transparent welche Optionen es gibt.</p>
        </details>
        <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
          <summary class="font-bold text-primary cursor-pointer">Wie schnell können Sie kommen?</summary>
          <p class="mt-3 text-primary/80 text-sm">Erstgespräch am Telefon meist innerhalb von 24 Stunden. Vor-Ort-Termin typisch innerhalb einer Woche. Bei akutem Termin-Druck (zum Beispiel Vermieter-Frist) sprechen Sie uns offen an.</p>
        </details>
        <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
          <summary class="font-bold text-primary cursor-pointer">Wie diskret arbeiten Sie?</summary>
          <p class="mt-3 text-primary/80 text-sm">Neutrale Fahrzeuge ohne auffällige Werbung. Unauffällige Kleidung. Wenn gewünscht, arbeiten wir zu Tageszeiten, die wenig Aufmerksamkeit auf sich ziehen. Niemand außerhalb des Auftrags muss wissen, dass wir bei Ihnen sind.</p>
        </details>
        <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
          <summary class="font-bold text-primary cursor-pointer">Wer zahlt das?</summary>
          <p class="mt-3 text-primary/80 text-sm">Bei vorhandenem Pflegegrad rechnen wir direkt mit der Pflegekasse ab. Bei fehlendem Pflegegrad helfen wir administrativ beim Antrag und können parallel die Entlastungsleistung erbringen, die bei Bewilligung rückwirkend ab Antragsdatum erstattet wird.</p>
        </details>
        <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
          <summary class="font-bold text-primary cursor-pointer">Was bedeutet die Anerkennung nach Para 45a SGB XI?</summary>
          <p class="mt-3 text-primary/80 text-sm">Wir sind als Anbieter zur Unterstützung im Alltag von der Anerkennungs-Stelle des Landes Baden-Württemberg für Stadt Stuttgart und Landkreis Böblingen anerkannt. Das heißt: wir können Entlastungsleistungen direkt mit Ihrer Pflegekasse abrechnen, ohne dass Sie das Geld vorstrecken müssen.</p>
        </details>
        <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
          <summary class="font-bold text-primary cursor-pointer">Wie unterscheidet sich Ihre Hilfe von der Pflegeberatung im Pflegestützpunkt?</summary>
          <p class="mt-3 text-primary/80 text-sm">Der Pflegestützpunkt berät Sie inhaltlich zu Ihren Pflegekassen-Ansprüchen, kostenlos und neutral. Wir setzen die operative Arbeit um: Antrag administrativ ausfüllen, Begutachtung vorbereiten, Wohnung räumen, reinigen, übergeben. Beide Rollen ergänzen sich, ersetzen sich nicht.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Standorte -->
  <section class="py-16 bg-background">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary text-center mb-4">Unser Einsatzgebiet</h2>
      <p class="text-center text-primary/80 mb-10 max-w-2xl mx-auto">
        Anerkannt nach §45a SGB XI für Stadt Stuttgart und Landkreis Böblingen. Operative Zentrale
        in Böblingen, Anfahrtszeiten 8 bis 40 Minuten je nach Ziel-Stadt.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 text-center">
        <a href="/standorte/stuttgart/" class="bg-white p-4 rounded-xl hover:shadow-md transition-shadow block">
          <p class="font-bold text-primary">Stuttgart</p>
          <p class="text-xs text-primary/70 mt-1">23 Bezirke</p>
        </a>
        <a href="/standorte/boeblingen/" class="bg-white p-4 rounded-xl hover:shadow-md transition-shadow block">
          <p class="font-bold text-primary">Böblingen</p>
          <p class="text-xs text-primary/70 mt-1">Zentrale</p>
        </a>
        <a href="/standorte/sindelfingen/" class="bg-white p-4 rounded-xl hover:shadow-md transition-shadow block">
          <p class="font-bold text-primary">Sindelfingen</p>
          <p class="text-xs text-primary/70 mt-1">8-12 Min</p>
        </a>
        <a href="/standorte/leonberg/" class="bg-white p-4 rounded-xl hover:shadow-md transition-shadow block">
          <p class="font-bold text-primary">Leonberg</p>
          <p class="text-xs text-primary/70 mt-1">18-25 Min</p>
        </a>
        <a href="/standorte/herrenberg/" class="bg-white p-4 rounded-xl hover:shadow-md transition-shadow block">
          <p class="font-bold text-primary">Herrenberg</p>
          <p class="text-xs text-primary/70 mt-1">20-28 Min</p>
        </a>
        <a href="/standorte/" class="bg-primary text-white p-4 rounded-xl hover:opacity-90 transition-opacity block">
          <p class="font-bold">Alle Standorte</p>
          <p class="text-xs opacity-80 mt-1">+ 20 Gemeinden</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Ratgeber -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary text-center mb-4">Ratgeber zu Pflegekasse und Räumung</h2>
      <p class="text-center text-primary/80 mb-10 max-w-2xl mx-auto">
        Verfasst von Daniel Altenhof, fachlich gegengelesen von Kemal David Gülcü. Mit aktuellen
        Beträgen 2026 und Bezug auf den SGB-XI-Gesetzestext.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/ratgeber/pflegekasse-entlastung/" class="bg-background/40 p-5 rounded-xl border border-primary/10 hover:shadow-md transition-shadow block">
          <h3 class="font-bold text-primary">Pflegekassen-Töpfe 2026</h3>
          <p class="mt-2 text-sm text-primary/70">§45a, §45b, §42a, §40 SGB XI im Überblick</p>
        </a>
        <a href="/ratgeber/entlastungsbetrag-richtig-nutzen/" class="bg-background/40 p-5 rounded-xl border border-primary/10 hover:shadow-md transition-shadow block">
          <h3 class="font-bold text-primary">Entlastungsbetrag 131 € richtig nutzen</h3>
          <p class="mt-2 text-sm text-primary/70">§45b im Detail mit Rechen-Beispielen</p>
        </a>
        <a href="/ratgeber/pflegegrad-1-was-zahlt-die-kasse/" class="bg-background/40 p-5 rounded-xl border border-primary/10 hover:shadow-md transition-shadow block">
          <h3 class="font-bold text-primary">Pflegegrad 1 – was zahlt die Kasse?</h3>
          <p class="mt-2 text-sm text-primary/70">Bis 6.000 € pro Jahr auch bei niedrigstem PG</p>
        </a>
        <a href="/ratgeber/pflegekasse-direktabrechnung/" class="bg-background/40 p-5 rounded-xl border border-primary/10 hover:shadow-md transition-shadow block">
          <h3 class="font-bold text-primary">Direktabrechnung erklärt</h3>
          <p class="mt-2 text-sm text-primary/70">Wie die Abtretung läuft, ohne Vorkasse</p>
        </a>
        <a href="/ratgeber/pflegekasse-ablehnung-widerspruch/" class="bg-background/40 p-5 rounded-xl border border-primary/10 hover:shadow-md transition-shadow block">
          <h3 class="font-bold text-primary">Widerspruch einlegen</h3>
          <p class="mt-2 text-sm text-primary/70">1-Monats-Frist nach Pflegekassen-Ablehnung</p>
        </a>
        <a href="/ratgeber/heimumzug-kosten/" class="bg-background/40 p-5 rounded-xl border border-primary/10 hover:shadow-md transition-shadow block">
          <h3 class="font-bold text-primary">Heimumzug und Kosten</h3>
          <p class="mt-2 text-sm text-primary/70">Wer zahlt die Wohnungsräumung?</p>
        </a>
      </div>
      <p class="text-center mt-8">
        <a href="/ratgeber/" class="underline text-accent-dark font-bold">Alle 10 Ratgeber ansehen &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-background">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-primary">Bereit für das erste Gespräch?</h2>
      <p class="mt-4 text-primary/80">
        Erzählen Sie uns kurz Ihre Situation. Im kostenlosen Erstgespräch klären wir gemeinsam,
        welche Pflegekassen-Optionen für Sie in Frage kommen und wann wir kommen können.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8 justify-center">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-home-final" />
      </div>
    </div>
  </section>
</PageLayout>
