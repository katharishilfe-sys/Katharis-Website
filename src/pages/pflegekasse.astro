---
import PageLayout from '@layouts/PageLayout.astro';
import { hooks, pflegekassenTöpfe } from '@data/content';
import { generateFAQPageSchema } from '@lib/schema-org';
import CallCTA from '@components/CallCTA';
import RueckrufButton from '@components/RueckrufButton';

const faqs = [
  {
    question: 'Was ist der Unterschied zwischen Entlastungsbetrag und Gemeinsamem Jahresbetrag?',
    answer:
      'Der Entlastungsbetrag (Para 45b, 131 Euro pro Monat) gilt für alle Pflegegrade 1 bis 5 und ist explizit für Entlastungsleistungen anerkannter Anbieter. Der Gemeinsame Jahresbetrag (Para 42a, bis 3.539 Euro pro Jahr) gilt nur ab Pflegegrad 2 und ist eigentlich für Verhinderungs- und Kurzzeitpflege, kann aber flexibel auch für Entlastungsleistungen eingesetzt werden.',
  },
  {
    question: 'Wann verfällt mein Entlastungsbetrag?',
    answer:
      'Der Entlastungsbetrag eines Kalenderjahres kann ins Folgejahr übertragen werden, verfällt dann aber am 30. Juni des Folgejahres. Beispiel: was Sie 2025 nicht abrufen, können Sie noch bis 30. Juni 2026 nutzen, danach ist es weg.',
  },
  {
    question: 'Brauche ich einen Pflegegrad, damit Sie kommen?',
    answer:
      'Für die Pflegekassen-Direktabrechnung ja. Wenn kein Pflegegrad vorliegt, helfen wir administrativ beim Antrag und beginnen die Arbeit gegebenenfalls als Privat-Auftrag, der bei Bewilligung rückwirkend über die Pflegekasse erstattet werden kann.',
  },
  {
    question: 'Was kostet das Erstgespräch?',
    answer:
      'Nichts. Sowohl das Telefon-Erstgespräch als auch ein Vor-Ort-Termin zur Auftrags-Einschätzung sind kostenlos.',
  },
  {
    question: 'Was wenn meine Pflegekasse nicht zahlt?',
    answer:
      'Wir besprechen das transparent vor Auftragsbeginn. Bei einer Pflegekassen-Ablehnung haben Sie zwei Optionen: Widerspruch (über Pflegestützpunkt oder Sozialrechts-Anwalt, vermitteln wir gerne) oder Privat-Backup-Vertrag mit transparentem Festpreis oder Stundensatz und 19 Prozent Umsatzsteuer.',
  },
  {
    question: 'Welche Pflegekassen rechnet Katharis direkt ab?',
    answer:
      'Alle gesetzlichen Pflegekassen. Bei privaten Pflege-Pflichtversicherungen klären wir das im Einzelfall.',
  },
  {
    question: 'Welche Stadtteile von Stuttgart bedienen Sie?',
    answer:
      'Alle Stadtbezirke. Anfahrt aus unserer operativen Zentrale Böblingen, Stuttgart-Mitte ist in 25 bis 30 Minuten erreichbar.',
  },
];
const faqSchema = generateFAQPageSchema(faqs);
---

<PageLayout
  title="Pflegekasse zahlt Entlastung - 131 EUR pro Monat 2026 | Katharis"
  description="Wie Pflegekassen-Töpfe nach Para 45a/45b/42a/40 SGB XI Ihre Entlastungs-Kosten decken. Anerkannter Anbieter Stuttgart und LK Böblingen. Aktuelle Beträge 2026."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="bg-background py-16">
    <div class="max-w-content mx-auto px-4">
      <h1 class="text-4xl font-bold text-primary">Pflegekassen-Leistungen für Entlastung: Was Ihnen zusteht</h1>
      <p class="mt-4 text-lg text-primary/80">{hooks.master}</p>
      <p class="mt-2 text-sm text-primary/60">{hooks.geltungsbereich}</p>
    </div>
  </section>

  <!-- YMYL Trust-Block -->
  <section class="py-8 max-w-content mx-auto px-4">
    <div class="bg-primary/5 p-6 rounded-xl border border-primary/10">
      <p class="text-sm text-primary/80">
        <strong>Verfasser:</strong> Daniel Altenhof, Initiator und operativer Leiter Katharis
      </p>
      <p class="text-sm text-primary/80 mt-2">
        <strong>Stand:</strong> 2026-05-06. Fachliche Prüfung gegen Gesetzestext und sechs Fachquellen
        (gesetze-im-internet.de §45b SGB XI, Bundesgesundheitsministerium PUEG-Erklärungen, pflege.de,
        pflegekompassmagazin.de, sozialgesetzbuch-sgb.de, Compass Pflegeberatung).
      </p>
    </div>
  </section>

  <!-- Was ist Para 45a -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">Was ist Paragraph 45a SGB XI?</h2>
    <p class="text-primary/80">
      Paragraph 45a SGB XI regelt die Anerkennung von Anbietern zur Unterstützung im Alltag. Anbieter, die
      nach Para 45a anerkannt sind (wie Katharis für Stadt Stuttgart und Landkreis Böblingen), können
      Entlastungsleistungen direkt mit der Pflegekasse abrechnen. Das heißt: Sie als Klient müssen die Kosten
      nicht vorstrecken.
    </p>
    <p class="mt-4 text-primary/80">
      Die Entlastungs-Töpfe der Pflegeversicherung sind kumulierbar. In Kombination können sie bei Pflegegrad
      ab 2 oft die kompletten Kosten einer Entlastungsleistung decken.
    </p>
  </section>

  <!-- Akkordeon -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-6">Welche Pflegekassen-Töpfe sind für Entlastung relevant?</h2>
      <div class="space-y-4">
        {pflegekassenTöpfe.map((topf) => (
          <details class="border border-primary/20 rounded-lg p-4 bg-background/30">
            <summary class="font-bold text-primary cursor-pointer">{topf.paragraph}: {topf.title} ({topf.betrag})</summary>
            <div class="mt-3 text-primary/80 text-sm">
              <p><strong>Wer:</strong> {topf.wer}</p>
              <p class="mt-2">{topf.description}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- So gehen wir vor -->
  <section class="py-12 max-w-content mx-auto px-4">
    <h2 class="text-2xl font-bold text-primary mb-4">So gehen wir vor</h2>
    <p class="text-primary/80">
      Im kostenlosen Erstgespräch klären wir gemeinsam mit Ihnen, welche Pflegekassen-Leistungen für Ihre
      Situation in Frage kommen. Dabei müssen wir wissen:
    </p>
    <ul class="mt-4 space-y-1 text-primary/80 list-disc list-inside">
      <li>Liegt ein Pflegegrad vor und welcher (Pflegegrad 1 bis 5)?</li>
      <li>Wird eine Pflegesachleistung genutzt (relevant für Para 45a Abs. 4 Umwandlung)?</li>
      <li>Gibt es Restbudgets aus dem Vorjahr (Para 45b Verfall 30. Juni)?</li>
      <li>Welche Pflegekasse ist zuständig?</li>
    </ul>
    <p class="mt-4 text-primary/80">
      Noch kein Pflegegrad? Wir helfen beim Antrag administrativ. Bei Bewilligung kann die Pflegekasse Ihre
      Kosten ab Antragsdatum erstatten. Mehr dazu auf
      <a href="/pflegegrad-antrag/" class="underline text-accent-dark">Pflegegrad-Antrags-Hilfe</a>.
    </p>
  </section>

  <!-- Para 7a-Abgrenzung -->
  <section class="py-12 bg-white">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-4">Paragraph 7a-Abgrenzung</h2>
      <p class="text-primary/80">
        Wir helfen Ihnen administrativ beim Antrag und übernehmen die operative Entlastungsleistung. Wir leisten
        <strong>keine Pflegeberatung im Sinne von Paragraph 7a SGB XI</strong>. Das ist Aufgabe der
        Pflegestützpunkte und qualifizierter Pflegeberater mit Versorgungs-Vertrag mit der Pflegekasse.
      </p>
      <p class="mt-4 text-primary/80">
        Bei Beratungs-Bedarf vermitteln wir an Ihren Pflegestützpunkt oder die Compass Pflegeberatung
        (kostenlos, Telefon 0800 101 88 00). Bei Widerspruch gegen Pflegekassen-Bescheide vermitteln wir an
        Pflegestützpunkt oder Sozialrechts-Anwalt.
      </p>
    </div>
  </section>

  <!-- Hinweis -->
  <section class="py-8 max-w-content mx-auto px-4">
    <div class="bg-accent/10 p-4 rounded-xl text-sm text-primary/80">
      <strong>Hinweis:</strong> Pflegekassen-Entscheidungen sind individuell. Wir geben keine Rechtsberatung.
      Die finale Bewilligung liegt bei Ihrer Pflegekasse. Anerkannt für Stadt Stuttgart und Landkreis Böblingen.
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 bg-background">
    <div class="max-w-content mx-auto px-4">
      <h2 class="text-2xl font-bold text-primary mb-6">Häufige Fragen</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="border border-primary/20 rounded-lg p-4 bg-white">
            <summary class="font-bold text-primary cursor-pointer">{faq.question}</summary>
            <p class="mt-3 text-primary/80 text-sm">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-white">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-primary">Kostenloses Erstgespräch</h2>
      <p class="mt-4 text-primary/80">Wir klären mit Ihnen welche Töpfe für Ihre Situation in Frage kommen.</p>
      <div class="flex flex-col sm:flex-row gap-3 mt-8 justify-center">
        <CallCTA client:load />
        <RueckrufButton client:load sourceCta="rueckruf-pflegekasse-final" />
      </div>
    </div>
  </section>
</PageLayout>
