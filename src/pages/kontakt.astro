---
import PageLayout from '@layouts/PageLayout.astro';
import { kontakt } from '@data/content';
import { generateFAQPageSchema, generateBreadcrumbListSchema } from '@lib/schema-org';
import RueckrufButton from '@components/RueckrufButton';

const SITE_URL = 'https://katharis.de';

const kontaktFaqs = [
  {
    question: 'Muss ich zum Erstgespräch persönlich kommen?',
    answer:
      'Nein. Das Erstgespräch läuft am Telefon, das ist für beide Seiten unkomplizierter. Persönliche Treffen machen wir vor Ort bei Ihnen oder bei der pflegebedürftigen Person, nicht in unserer Zentrale.',
  },
  {
    question: 'Kann ich anonym anrufen?',
    answer:
      'Ja. Im ersten Gespräch reichen Vorname und Telefonnummer. Wenn Sie sich entscheiden mit uns weiter zu machen, brauchen wir später Adresse und Pflegekassen-Daten für die Auftrags-Verträge.',
  },
  {
    question: 'Was wenn ich nicht der Auftraggeber bin sondern Tochter oder Sohn?',
    answer:
      'Sie können anrufen und das Erstgespräch führen. Für den Auftrag selbst brauchen wir entweder die Einwilligung des Klienten oder eine Vollmacht. Bei Demenz oder Geschäftsunfähigkeit ist eine Vorsorgevollmacht oder gerichtliche Betreuung notwendig.',
  },
  {
    question: 'Telefon klingelt aber niemand nimmt ab',
    answer:
      'Wir sind im Einsatz. Sprechen Sie auf den Anrufbeantworter, wir rufen binnen 24 Stunden zurück. Oder füllen Sie das Rückruf-Formular aus, dann melden wir uns gezielt zu Ihrer Wunschzeit.',
  },
];

const faqSchema = generateFAQPageSchema(kontaktFaqs);

const breadcrumbSchema = generateBreadcrumbListSchema([
  { name: 'Start', url: 'https://katharis.de/' },
  { name: 'Kontakt', url: 'https://katharis.de/kontakt/' },
]);

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: `${SITE_URL}/kontakt/`,
  name: 'Kontakt Katharis - Pflegekassen-Entlastung Stuttgart und Böblingen',
  description: 'Telefon, Rückruf-Formular und Erreichbarkeit. Operative Zentrale Böblingen, Mo-Sa 8-20 Uhr.',
  mainEntity: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: kontakt.telefon,
      email: kontakt.email,
      contactType: 'customer service',
      areaServed: ['Stadt Stuttgart', 'Landkreis Böblingen'],
      availableLanguage: 'German',
      hoursAvailable: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '08:00',
        closes: '20:00',
      },
    },
  },
};
---

<PageLayout
  title="Kontakt Katharis Stuttgart - Kostenloses Erstgespräch"
  description="Telefon 07031 6953604 oder Rückruf-Form. Kostenloses Erstgespräch zu Pflegekassen-Entlastung in Stuttgart und LK Böblingen. Mo-Sa 8-20 Uhr."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="py-16 max-w-4xl mx-auto px-4">
    <p class="text-sm text-primary/80">
      <a href="/" class="underline">Start</a> &rsaquo; Kontakt
    </p>
    <h1 class="text-4xl font-bold text-primary mt-4">Sprechen Sie uns an</h1>
    <p class="mt-4 text-lg text-primary/80">
      Im kostenlosen Erstgespräch am Telefon klären wir Ihre Situation, Pflegekassen-Optionen
      und nächste Schritte.
    </p>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-white p-6 rounded-xl">
        <h2 class="text-xl font-bold text-primary">Jetzt anrufen</h2>
        <p class="mt-2 text-2xl font-bold text-accent-dark">
          <a href={`tel:${kontakt.telefonHref}`} class="hover:underline">{kontakt.telefonAnzeige}</a>
        </p>
        <p class="mt-2 text-primary/70">{kontakt.oeffnungszeiten}</p>
        <p class="mt-4 text-sm text-primary/70">
          Anrufe werden direkt von Daniel entgegengenommen. Außerhalb der Geschäftszeiten
          sprechen Sie auf den Anrufbeantworter, wir rufen binnen 24 Stunden zurück.
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl">
        <h2 class="text-xl font-bold text-primary">Rückruf anfordern</h2>
        <p class="mt-2 text-primary/70">
          Geben Sie uns Ihren Namen und eine Telefonnummer, wir rufen kostenlos zurück.
        </p>
        <div class="mt-6">
          <RueckrufButton client:load variant="primary" sourceCta="rueckruf-kontakt-page" fullWidth={true} />
        </div>
        <p class="mt-4 text-xs text-primary/80">
          Oder per Email: <a href={`mailto:${kontakt.email}`} class="underline">{kontakt.email}</a>
        </p>
      </div>
    </div>

    <div class="mt-12 bg-primary/5 p-6 rounded-xl">
      <h3 class="font-bold text-primary">Operative Zentrale</h3>
      <p class="mt-2 text-primary/80">
        {kontakt.adresse.operativeZentrale.strasse}, {kontakt.adresse.operativeZentrale.plz} {kontakt.adresse.operativeZentrale.ort}
      </p>
      <p class="mt-2 text-primary/80">
        Einsatzgebiet: Stadt Stuttgart, Landkreis Böblingen. Anerkannt nach §45a SGB XI für
        Direkt-Abrechnung mit der Pflegekasse. Details zum Geltungsbereich und allen Standorten unter
        <a href="/standorte/" class="underline text-accent-dark">Standorte</a>.
      </p>
    </div>

    <div class="mt-6 bg-accent/10 p-4 rounded-xl text-sm text-primary/80">
      <strong>Hinweis:</strong> Bei akuten Pflege-Notfällen wenden Sie sich bitte an Ihren
      Pflegestützpunkt oder im medizinischen Notfall an 112.
    </div>

    <!-- Erreichbarkeit Detail -->
    <section class="mt-12 bg-white p-6 rounded-xl">
      <h2 class="text-2xl font-bold text-primary mb-4">Erreichbarkeit im Detail</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-primary/80">
        <div>
          <h3 class="font-bold text-primary">Telefonische Erreichbarkeit</h3>
          <ul class="mt-2 space-y-1 list-disc list-inside">
            <li>Montag bis Samstag, 8 bis 20 Uhr</li>
            <li>Erstgespräch kostenlos und unverbindlich</li>
            <li>Bei besetzter Leitung Rueckruf binnen 24 Stunden</li>
            <li>Auf Wunsch terminierter Rueckruf zu fester Uhrzeit</li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-primary">Email-Antwort</h3>
          <ul class="mt-2 space-y-1 list-disc list-inside">
            <li>Werktags: binnen 24 Stunden</li>
            <li>Wochenende: binnen 72 Stunden</li>
            <li>Datenschutz nach DSGVO, Server in Deutschland</li>
            <li>Auch Email mit sensiblen Inhalten möglich, wir behandeln vertraulich</li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-primary">Vor-Ort-Termin</h3>
          <ul class="mt-2 space-y-1 list-disc list-inside">
            <li>Typisch innerhalb einer Woche</li>
            <li>Bei akutem Termin-Druck (Vermieter-Frist) schneller</li>
            <li>Komplett kostenlos, auch wenn kein Auftrag zustande kommt</li>
            <li>Mit Daniel direkt, nicht mit Subunternehmer</li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-primary">Was wir bei der ersten Anfrage brauchen</h3>
          <ul class="mt-2 space-y-1 list-disc list-inside">
            <li>Wo (PLZ und Stadtteil reichen)</li>
            <li>Was (kurze Situations-Beschreibung)</li>
            <li>Pflegegrad ja oder nein, falls bekannt</li>
            <li>Termin-Druck (Vermieter-Frist, Heim-Einzug, etc.)</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Anfahrt -->
    <section class="mt-12 bg-white p-6 rounded-xl">
      <h2 class="text-2xl font-bold text-primary mb-4">Anfahrt zur operativen Zentrale</h2>
      <p class="text-primary/80">
        Wenn Sie persönlich vorbeikommen wollen (z.B. für Auftrags-Unterzeichnung oder Schlüssel-Übergabe),
        gerne nach telefonischer Anmeldung unter <a href={`tel:${kontakt.telefonHref}`} class="underline text-accent-dark">{kontakt.telefonAnzeige}</a>.
      </p>
      <p class="mt-3 text-sm text-primary/80">
        <strong>Adresse:</strong> {kontakt.adresse.operativeZentrale.strasse}, {kontakt.adresse.operativeZentrale.plz} {kontakt.adresse.operativeZentrale.ort}
      </p>
      <p class="mt-3 text-sm text-primary/80">
        <strong>OePNV:</strong> S-Bahn S1 bis Böblingen Bahnhof, dann 8 Minuten Fussweg. Bus-Verbindungen
        regelmaessig.
      </p>
      <p class="mt-3 text-sm text-primary/80">
        <strong>Auto:</strong> Parkmöglichkeiten in der Olgastraße vor dem Haus, sonst Tiefgarage Böblingen-City.
      </p>
    </section>

    <!-- Kontakt-FAQ -->
    <section class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-4">Kontakt-Fragen</h2>
      <div class="space-y-3">
        <details class="border border-primary/20 rounded-lg p-4 bg-white">
          <summary class="font-bold text-primary cursor-pointer">Muss ich zum Erstgespräch persönlich kommen?</summary>
          <p class="mt-3 text-primary/80 text-sm">
            Nein. Das Erstgespräch laeuft am Telefon, das ist für beide Seiten unkomplizierter. Persönliche Treffen
            machen wir vor Ort bei Ihnen oder bei der pflegebedürftigen Person, nicht in unserer Zentrale.
          </p>
        </details>
        <details class="border border-primary/20 rounded-lg p-4 bg-white">
          <summary class="font-bold text-primary cursor-pointer">Kann ich anonym anrufen?</summary>
          <p class="mt-3 text-primary/80 text-sm">
            Ja. Im ersten Gespräch reichen Vorname und Telefonnummer. Wenn Sie sich entscheiden mit uns weiter zu machen,
            brauchen wir später Adresse und Pflegekassen-Daten für die Auftrags-Vertraege.
          </p>
        </details>
        <details class="border border-primary/20 rounded-lg p-4 bg-white">
          <summary class="font-bold text-primary cursor-pointer">Was wenn ich nicht der Auftraggeber bin sondern Tochter/Sohn?</summary>
          <p class="mt-3 text-primary/80 text-sm">
            Sie können anrufen und das Erstgespräch führen. Für den Auftrag selbst brauchen wir entweder die
            Einwilligung des Klienten oder eine Vollmacht. Bei Demenz oder Geschäftsunfähigkeit ist eine Vorsorgevollmacht
            oder gerichtliche Betreuung notwendig.
          </p>
        </details>
        <details class="border border-primary/20 rounded-lg p-4 bg-white">
          <summary class="font-bold text-primary cursor-pointer">Telefon klingelt aber niemand nimmt ab</summary>
          <p class="mt-3 text-primary/80 text-sm">
            Wir sind im Einsatz. Sprechen Sie auf den Anrufbeantworter, wir rufen binnen 24 Stunden zurueck.
            Oder fuellen Sie das Rueckruf-Formular aus, dann melden wir uns gezielt zu Ihrer Wunschzeit.
          </p>
        </details>
      </div>
    </section>
  </section>
</PageLayout>
